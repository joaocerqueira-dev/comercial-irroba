generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StorePreview {
  id               String   @id @default(cuid())
  slug             String   @unique
  sourceUrl        String
  detectedPlatform String?
  storeName        String
  sellerWhatsapp   String?
  generationMode   String   @default("heuristic") // gemini | heuristic
  status           String   @default("processing") // processing | ready | error
  errorMessage     String?
  screenshotPath   String?
  extractedData    Json?
  blueprint        Json?
  compiledExport   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  shareExpiresAt   DateTime?
  sharePasswordHash String?
  shareStatus      String   @default("pendente")
  contentVersion   Int      @default(1)
  legacyPublic     Boolean  @default(true) // propostas antigas seguem públicas; novas gravam false
  aiProvider       String?
  aiModel          String?
  responses        ClientResponse[]

  @@index([ownerId, status, createdAt])
  @@index([status, createdAt]) // GET /api/previews: where status order by createdAt
  @@index([createdAt])
}

model ClientResponse {
  id             String       @id @default(cuid())
  previewId      String
  preview        StorePreview @relation(fields: [previewId], references: [id], onDelete: Cascade)
  type           String
  clientName     String
  message        String?
  contentVersion Int
  createdAt      DateTime     @default(now())
  seenAt         DateTime?

  @@index([previewId, createdAt])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               String    @default("comercial") // comercial | admin
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]
  previews           StorePreview[]
  aiCredentials      AiCredential[]
}

model Session {
  id        String   @id // SHA-256 hex do token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AiCredential {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // openai | anthropic | google | openai-compatible
  purpose         String   // texto | imagem
  apiKeyEncrypted String
  baseUrl         String?  // só openai-compatible
  model           String?
  last4           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, purpose])
}
