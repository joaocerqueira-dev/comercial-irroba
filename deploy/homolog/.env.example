# Copie para .env (cp .env.example .env) e preencha. Nunca commite o .env.

# Versão da imagem: "main" acompanha a última versão da main; "sha-xxxxxxx" fixa um commit.
APP_TAG=main

# Qual túnel sobe junto: "tunnel" (com domínio, precisa de TUNNEL_TOKEN) ou "quick" (sem domínio).
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=

# Primeiro admin, criado quando não há usuários. Depois a senha é trocada em /conta/senha.
ADMIN_EMAIL=
ADMIN_PASS=

# Gere cada um com: openssl rand -base64 48
SESSION_SECRET=
# Cifra as chaves de IA dos usuários. Trocar depois invalida as chaves já salvas.
AI_KEYS_SECRET=

# Endereço público do sistema (o do túnel), sem barra no fim.
PUBLIC_ASSET_BASE_URL=https://homolog.suaempresa.com.br

# Opcionais
# RATE_LIMIT_PER_MIN=30
# MAX_BROWSER_JOBS=2
# PLAYWRIGHT_NO_SANDBOX=1   # só se o sandbox do Chromium falhar (ver docs/deploy.md)
