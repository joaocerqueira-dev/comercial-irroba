                  <button type="button" class="customFilterV2-toggle" id="irb-open-cat-filters" aria-label="Abrir filtros">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
                    <span>Filtrar</span>
                    <span id="irb-cat-filter-badge" style="display:none;padding:1px 6px;border-radius:999px;background:rgba(255,255,255,0.25);font-size:11px;">0</span>
                  </button>
                  <div class="toolbar-shop-sorter">
                    <span>Visualização:</span>
                    <button type="button" class="js-changeGrid active" data-grid-cols="3" title="3 colunas" aria-label="Exibir 3 produtos por linha"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="4.5" height="7" rx="1"/><rect x="9.75" y="4" width="4.5" height="7" rx="1"/><rect x="16.5" y="4" width="4.5" height="7" rx="1"/><rect x="3" y="13" width="4.5" height="7" rx="1"/><rect x="9.75" y="13" width="4.5" height="7" rx="1"/><rect x="16.5" y="13" width="4.5" height="7" rx="1"/></svg></button>
                    <button type="button" class="js-changeGrid" data-grid-cols="4" title="4 colunas" aria-label="Exibir 4 produtos por linha"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="7.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="12.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="17.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="2.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="7.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="12.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="17.5" y="13" width="3.5" height="7" rx="0.8"/></svg></button>
                  </div>
                </div>
                <select id="irb-cat-sort" class="categorySortSelect" aria-label="Ordenar produtos">
