    <!-- 2. VIEW: TELA DE CATEGORIA / BUSCA (.pageLayout--category com Filtro Lateral Esquerdo Irroba) -->
    <div id="irb-view-category" class="storeView">
      <div class="container">
        <nav class="irb-breadcrumb" aria-label="Breadcrumb">
          <button type="button" data-go-home="1">Início</button>
          <span>/</span>
          <strong id="irb-cat-breadcrumb" style="color:var(--body-foreground);">Categoria</strong>
        </nav>

        <div class="categoryHeroHeader">
          <div>
            <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;opacity:0.7;">Departamento</span>
            <h2 id="irb-cat-title" style="margin:4px 0 6px;font-size:32px;line-height:1.15;">Categoria</h2>
            <p id="irb-cat-count" style="margin:0;font-size:14px;opacity:0.8;">0 produtos encontrados</p>
          </div>
          <button type="button" data-go-home="1" class="product-btn" style="width:auto;padding:10px 18px;">Voltar à Página Inicial</button>
        </div>

        <div class="irb-cat-filter-backdrop" id="irb-cat-filter-backdrop" aria-hidden="true"></div>

        <div class="pageContent pageContent--category">
          <aside class="pageColumnLeft categorySidebar" id="irb-cat-sidebar" aria-label="Filtros da categoria">
            <div class="categorySidebar__head">
              <strong style="font-size:15px;color:#111827;">Filtrar Produtos</strong>
              <button type="button" class="categorySidebar__close" id="irb-cat-filter-close" aria-label="Fechar filtros"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
            </div>

            <div class="irb-active-filters" id="irb-active-filters"></div>

            <details open class="filters filter-category-container">
              <summary>
                <span class="filter-title">Categorias</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <ul class="filterSidebarList" id="irb-sidebar-cats">
                <li>
                  <button type="button" class="filterSidebarBtn active" data-sidebar-cat="all">
                    <span>Todos os produtos</span>
                    <span class="filterSidebarCount" data-cat-count="all">10</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="filterSidebarBtn" data-sidebar-cat="Categoria A">
                    <span>Categoria A</span>
                    <span class="filterSidebarCount" data-cat-count="categoria a">0</span>
                  </button>
                </li><li>
                  <button type="button" class="filterSidebarBtn" data-sidebar-cat="Categoria B">
                    <span>Categoria B</span>
                    <span class="filterSidebarCount" data-cat-count="categoria b">0</span>
                  </button>
                </li>
              </ul>
            </details>

            <details open class="filters filter-price-container" data-price-name="Faixa de Preço">
              <summary>
                <span class="filter-title">Faixa de Preço</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="filterPricePresets" id="irb-price-presets">
                <button type="button" class="filterPresetBtn" data-price-min="" data-price-max="150">Até R$ 150</button>
                <button type="button" class="filterPresetBtn" data-price-min="150" data-price-max="350">R$ 150 – R$ 350</button>
                <button type="button" class="filterPresetBtn" data-price-min="350" data-price-max="">Acima de R$ 350</button>
              </div>
              <div class="range_inputs">
                <div>
                  <label for="min-price-input">Mínimo (R$)</label>
                  <input type="number" min="0" step="1" id="min-price-input" class="price-input" placeholder="0" />
                </div>
                <div>
                  <label for="max-price-input">Máximo (R$)</label>
                  <input type="number" min="0" step="1" id="max-price-input" class="price-input" placeholder="9999" />
                </div>
              </div>
            </details>

            <details open class="filters filter-promo-container">
              <summary>
                <span class="filter-title">Ofertas</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <label class="filterCheckboxLabel">
                <input type="checkbox" id="irb-filter-promo-only" />
                <span>Apenas em promoção</span>
              </label>
            </details>

            <div class="filterActionContainer">
              <button type="button" id="irb-apply-filters-btn" class="filter-button">Aplicar</button>
              <button type="button" id="irb-clear-filters-btn" class="clear-filters">Limpar</button>
            </div>
          </aside>

          <div id="mainContent" class="pageContent__main">
            <div class="pageControls pageControls--category">
              <div class="toolbar-shop">
                <div class="toolbar-shop-left">
                  <button type="button" class="customFilterV2-toggle" id="irb-open-cat-filters" aria-label="Abrir filtros">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
                    <span>Filtrar</span>
                    <span id="irb-cat-filter-badge" style="display:none;padding:1px 6px;border-radius:999px;background:rgba(255,255,255,0.25);font-size:11px;">0</span>
                  </button>
                  <div class="toolbar-shop-sorter">
                    <span>Visualização:</span>
                    <button type="button" class="js-changeGrid active" data-grid-cols="3" title="3 colunas" aria-label="Exibir 3 produtos por linha"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="4.5" height="7" rx="1"/><rect x="9.75" y="4" width="4.5" height="7" rx="1"/><rect x="16.5" y="4" width="4.5" height="7" rx="1"/><rect x="3" y="13" width="4.5" height="7" rx="1"/><rect x="9.75" y="13" width="4.5" height="7" rx="1"/><rect x="16.5" y="13" width="4.5" height="7" rx="1"/></svg></button>
                    <button type="button" class="js-changeGrid" data-grid-cols="4" title="4 colunas" aria-label="Exibir 4 produtos por linha"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="7.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="12.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="17.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="2.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="7.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="12.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="17.5" y="13" width="3.5" height="7" rx="0.8"/></svg></button>
                  </div>
                </div>
                <select id="irb-cat-sort" class="categorySortSelect" aria-label="Ordenar produtos">
                  <option value="relevance">Ordenar: Padrão</option>
                  <option value="name-asc">Nome (A - Z)</option>
                  <option value="name-desc">Nome (Z - A)</option>
                  <option value="price-asc">Menor Preço</option>
                  <option value="price-desc">Maior Preço</option>
                  <option value="discount-desc">Maiores Descontos</option>
                </select>
              </div>
            </div>

            <div class="productList__grid productList--category" id="irb-cat-grid"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. VIEW: PÁGINA COMPLETA DE PRODUTO (PDP .product-content) -->
    <div id="irb-view-product" class="storeView">
      <div class="container">
        <nav class="irb-breadcrumb" aria-label="Breadcrumb">
          <button type="button" data-go-home="1">Início</button>
          <span>/</span>
          <button type="button" id="irb-pdp-cat-link">Categoria</button>
          <span>/</span>
          <strong id="irb-pdp-breadcrumb-title" style="color:var(--body-foreground);">Produto</strong>
        </nav>

        <div class="pdpGrid">
          <div class="pdpGallery">
            <div class="pdpThumbs" id="irb-pdp-thumbs"></div>
            <div class="pdpMainImageWrap">
              <img id="irb-pdp-img" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="Produto" />
            </div>
          </div>

          <div class="productInfo">
            <span id="irb-pdp-cat" style="font-size:11px;text-transform:uppercase;color:#6b7280;letter-spacing:0.08em;font-weight:700;"></span>
            <h2 id="irb-pdp-title" class="productInfo__title"></h2>
            <div class="pdpRating">
              <span style="color:#f59e0b;letter-spacing:2px;">★★★★★</span>
              <span>5.0 · 18 avaliações verificadas</span>
            </div>

            <div class="pdpPriceBox">
              <div id="irb-pdp-old" style="font-size:14px;color:var(--product-old-price-color);text-decoration:line-through;"></div>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                <span id="irb-pdp-price" style="font-size:30px;font-weight:800;color:var(--product-price-color);"></span>
                <span id="irb-pdp-pix-badge" style="font-size:12px;font-weight:700;padding:4px 10px;border-radius:999px;background:var(--primary-background);color:var(--primary-foreground);"></span>
              </div>
              <div id="irb-pdp-installments" style="font-size:13px;margin-top:6px;opacity:0.85;"></div>
            </div>

            <div>
              <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;">Selecione uma opção:</div>
              <div class="pdpSizeList" id="irb-pdp-sizes">
                <button type="button" class="pdpSizeBtn active" data-size-opt="Padrão">Padrão</button>
              </div>
            </div>

            <div class="pdpBuyRow">
              <div class="pdpQtyBox">
                <button type="button" id="irb-pdp-qty-dec" aria-label="Diminuir">−</button>
                <span id="irb-pdp-qty">1</span>
                <button type="button" id="irb-pdp-qty-inc" aria-label="Aumentar">+</button>
              </div>
              <button type="button" id="irb-pdp-add" class="product-btn" style="flex:1;padding:14px 20px;font-size:15px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                <span>Comprar agora</span>
              </button>
            </div>

            <div class="pdpShippingBox">
              <div style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;margin-bottom:8px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                <span>Calcular Frete e Prazo</span>
              </div>
              <form id="irb-cep-form" style="display:flex;gap:8px;">
                <input type="text" id="irb-cep-input" placeholder="Digite seu CEP (ex: 14400-000)" style="flex:1;padding:9px 12px;border:1px solid #d1d5db;border-radius:var(--irb-radius);font-size:13px;" />
                <button type="submit" style="padding:9px 16px;border:none;border-radius:var(--irb-radius);background:var(--primary-background);color:var(--primary-foreground);font-weight:700;font-size:13px;cursor:pointer;">Calcular</button>
              </form>
              <div id="irb-cep-result" style="margin-top:8px;font-size:12px;color:#374151;display:none;"></div>
            </div>

            <div style="border-top:1px solid rgba(0,0,0,0.08);padding-top:16px;">
              <h3 style="margin:0 0 8px;font-size:15px;">Descrição do Produto</h3>
              <p id="irb-pdp-desc" style="font-size:14px;line-height:1.6;opacity:0.88;margin:0;"></p>
            </div>
          </div>
        </div>

        <section style="border-top:1px solid rgba(0,0,0,0.08);padding:38px 0 56px;">
          <h2 class="productList__title" style="font-size:24px;margin-bottom:20px;">Produtos Relacionados</h2>
          <div class="productList__grid" id="irb-pdp-related"></div>
        </section>
      </div>
    </div>
  </main>

