      <div style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;opacity:0.65;margin-bottom:18px;">Envio Rápido  ·  Até 6x Sem Juros  ·  Compra 100% Segura</div>
      <p style="margin:0 0 28px 0;font-size:15px;line-height:1.75;opacity:0.86;">suplemento whey academia</p>
      <a href="#vitrines" style="display:inline-flex;align-items:center;gap:10px;padding:13px 26px;border:1px solid #111827;color:#111827;background:transparent;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;border-radius:12px;">Ver Coleção &#8594;</a>
    </div>
  </div>
  <div style="margin:0 calc(-1 * clamp(20px,4vw,52px));background:#0E131F;color:#FFFFFF;padding:clamp(34px,4.5vw,54px) clamp(20px,4vw,52px);box-sizing:border-box;">
    <div style="max-width:1280px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:22px;">
      <div style="flex:1 1 440px;">
        <div style="font-size:11px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;opacity:0.72;margin-bottom:8px;">Experiência Fit Sup</div>
        <div style="font-family:'Anton',sans-serif;font-size:clamp(20px,2.4vw,28px);font-weight:400;line-height:1.25;color:#FFFFFF;">Frete Grátis em compras selecionadas • 5% OFF no PIX • Parcele em até 6x sem juros</div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:12px;">
        <a href="#vitrines" style="display:inline-block;padding:13px 26px;background:#111827;color:#FFFFFF;border:1px solid transparent;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;border-radius:12px;">Comprar Agora</a>
        <a href="#categoria" data-irb-cat="all" style="display:inline-block;padding:13px 26px;background:transparent;color:#FFFFFF;border:1px solid #FFFFFF;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;border-radius:12px;">Ver Tudo</a>
      </div>
    </div>
  </div>
</div>",
