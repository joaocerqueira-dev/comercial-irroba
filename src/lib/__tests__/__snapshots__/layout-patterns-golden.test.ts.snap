      "id": "irb-html-editorial-gallery",
      "moduleTitle": "Conteúdo HTML · Galeria Editorial",
      "name": "Galeria Editorial de Coleções (3:4 + Movimento Suave)",
      "placementNote": "Posicionar em Página Inicial > Topo do Conteúdo logo após a Tarja Informativa. Usa 100% CSS inline + animação SVG SMIL nativa sem JavaScript (compatível com SunEditor).",
      "recommendedWidth": "Largura Total",
    },
    {
      "html": "<div style="position:relative;left:50%;width:100vw;max-width:100vw;margin-left:-50vw;background:#ECEDEE;color:#111827;padding:clamp(48px,7vw,88px) clamp(20px,4vw,52px) 0;box-sizing:border-box;">
  <div style="max-width:1280px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:clamp(32px,5vw,68px);padding-bottom:clamp(54px,7vw,84px);">
    <div style="flex:1.25 1 360px;position:relative;">
      <div style="position:relative;aspect-ratio:10/7;border-radius:0px;overflow:hidden;background:#18181b;">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800&amp;q=80" alt="Editorial Loja Exemplo" referrerpolicy="no-referrer" style="width:100%;height:100%;object-fit:cover;display:block;" />
        <span style="position:absolute;top:16px;left:16px;font-size:10px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#ffffff;background:rgba(0,0,0,0.45);padding:6px 12px;border-radius:999px;">Lookbook · Loja Exemplo</span>
      </div>
      <div data-open-pdp="demo-1" style="position:absolute;right:-10px;bottom:-18px;width:clamp(108px,14vw,156px);aspect-ratio:1/1;border-radius:0px;overflow:hidden;border:4px solid #ECEDEE;box-shadow:0 18px 36px rgba(0,0,0,0.16);background:#ffffff;cursor:pointer;">
          <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800&amp;q=80" alt="Produto Destaque Loja Exemplo" referrerpolicy="no-referrer" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
    </div>
    <div style="flex:1 1 320px;">
      <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;padding-bottom:14px;border-bottom:1px solid rgba(0,0,0,0.14);opacity:0.76;">
        <span>01 / Manifesto</span>
        <span>Varejo Online</span>
      </div>
      <h2 style="margin:22px 0 16px 0;font-family:'Montserrat',sans-serif;font-size:clamp(28px,3.6vw,46px);font-weight:300;line-height:1.05;letter-spacing:-0.02em;color:#111827;">Descubra a essência e os detalhes de Loja <em style="font-style:italic;font-weight:400;color:#111827;">Exemplo</em></h2>
      <div style="font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;opacity:0.65;margin-bottom:18px;">Envio Rápido  ·  Até 6x Sem Juros  ·  Compra 100% Segura</div>
      <p style="margin:0 0 28px 0;font-size:15px;line-height:1.75;opacity:0.86;">Loja Exemplo — Curadoria especial com qualidade, estilo e entrega para todo o Brasil.</p>
      <a href="#vitrines" style="display:inline-flex;align-items:center;gap:10px;padding:13px 26px;border:1px solid #111827;color:#111827;background:transparent;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;border-radius:0px;">Ver Coleção &#8594;</a>
    </div>
  </div>
  <div style="margin:0 calc(-1 * clamp(20px,4vw,52px));background:#0E131F;color:#FFFFFF;padding:clamp(34px,4.5vw,54px) clamp(20px,4vw,52px);box-sizing:border-box;">
    <div style="max-width:1280px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:22px;">
      <div style="flex:1 1 440px;">
        <div style="font-size:11px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;opacity:0.72;margin-bottom:8px;">Experiência Loja Exemplo</div>
        <div style="font-family:'Montserrat',sans-serif;font-size:clamp(20px,2.4vw,28px);font-weight:400;line-height:1.25;color:#FFFFFF;">Frete Grátis em compras selecionadas • 5% OFF no PIX • Parcele em até 6x sem juros</div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:12px;">
        <a href="#vitrines" style="display:inline-block;padding:13px 26px;background:#111827;color:#FFFFFF;border:1px solid transparent;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;border-radius:0px;">Comprar Agora</a>
        <a href="#categoria" data-irb-cat="all" style="display:inline-block;padding:13px 26px;background:transparent;color:#FFFFFF;border:1px solid #FFFFFF;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;border-radius:0px;">Ver Tudo</a>
      </div>
    </div>
  </div>
</div>",
