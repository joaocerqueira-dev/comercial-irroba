      <a href="#vitrines" data-irb-cat="Categoria B" style="position:relative;flex:1 0 min(260px,74vw);scroll-snap-align:start;aspect-ratio:3/4;min-height:340px;border-radius:12px;overflow:hidden;display:block;text-decoration:none;background:#141416;color:#ffffff;box-sizing:border-box;">
