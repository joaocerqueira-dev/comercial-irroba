        <a href="#categoria" data-irb-cat="all" style="display:inline-block;padding:13px 26px;background:transparent;color:#FFFFFF;border:1px solid #FFFFFF;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;border-radius:24px;">Ver Tudo</a>
