exports[`layout patterns golden > fitness > html 1`] = `
"<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fit Sup — Preview Irroba LIME</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Lato:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..500,0..1,-50..200" rel="stylesheet" />
  <style>
    :root {
      --primary-background: #111827;
      --primary-foreground: #FFFFFF;
      --secondary-background: #0E131F;
      --secondary-foreground: #FFFFFF;
      --neutral-background: #ECEDEE;
      --neutral-foreground: #111827;
      --body-background: #FFFFFF;
      --body-foreground: #111827;
      --btn-primary-background: #111827;
      --btn-primary-color: #FFFFFF;
      --btn-primary-border: transparent;
      --btn-secondary-background: #111827;
      --btn-secondary-color: #FFFFFF;
      --btn-secondary-border: #111827;
      --announcement-background: #111827;
      --announcement-foreground: #FFFFFF;
      --header-background: #FFFFFF;
      --header-foreground: #111827;
      --header-link-hover-color: #111827;
      --header-link-hover-bg: rgba(0, 0, 0, 0.07);
      --title-font-family: 'Anton', sans-serif;
      --text-font-family: 'Lato', sans-serif;
      --irb-radius: 12px;
      --productGrid-background: #FFFFFF;
      --productGrid-information-padding-x: 16px;
      --productList-buy-btn-background: #111827;
      --productList-buy-btn-foreground: #FFFFFF;
      --productList-buy-btn-border: transparent;
      --product-price-color: #111827;
      --product-old-price-color: #9CA3AF;
      --footer-background: #0E131F;
      --footer-foreground: #FFFFFF;
      --footerLegal-background: #0B0E17;
      --footerLegal-foreground: #FFFFFF;
    }

    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      background: var(--body-background);
      color: var(--body-foreground);
      font-family: var(--text-font-family);
      overflow-x: clip;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 { font-family: var(--title-font-family); }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 20px; }
    .container-full { width: 100%; padding: 0 24px; }

    /* Tarja Informativa (.overlineModule) + Ticker Rolante */
    .overlineModule {
      background: var(--announcement-background);
      color: var(--announcement-foreground);
      font-size: 12px;
      font-weight: 600;
      text-align: center;
      padding: 8px 16px;
      letter-spacing: 0.03em;
    }
    .overlineModule--ticker {
      position: relative;
      overflow: hidden;
      min-height: 34px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .overlineModule__track {
      position: relative;
      width: 100%;
      max-width: 1280px;
      height: 34px;
      overflow: hidden;
    }
    .overlineModule__slide {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0;
      transform: translate3d(0, 100%, 0);
      transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.38s ease;
      pointer-events: none;
      will-change: transform, opacity;
    }
    .overlineModule--ticker[data-transition="slide-horizontal"] .overlineModule__slide {
      transform: translate3d(100%, 0, 0);
    }
    .overlineModule--ticker[data-transition="fade"] .overlineModule__slide {
      transform: translate3d(0, 0, 0);
    }
    .overlineModule--ticker .overlineModule__slide.is-resetting {
      transition: none !important;
      opacity: 0;
    }
    .overlineModule--ticker .overlineModule__slide.is-active,
    .overlineModule--ticker[data-transition="slide-horizontal"] .overlineModule__slide.is-active,
    .overlineModule--ticker[data-transition="fade"] .overlineModule__slide.is-active {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      pointer-events: auto;
    }
    .overlineModule--ticker .overlineModule__slide.is-leaving {
      opacity: 0;
      transform: translate3d(0, -100%, 0);
    }
    .overlineModule--ticker[data-transition="slide-horizontal"] .overlineModule__slide.is-leaving {
      opacity: 0;
      transform: translate3d(-100%, 0, 0);
    }
    .overlineModule--ticker[data-transition="fade"] .overlineModule__slide.is-leaving {
      opacity: 0;
      transform: translate3d(0, 0, 0);
    }

    /* Cabeçalho Tema LIME (.headerContent) — Fundo independente da Logo + Posicionamento fiel */
    header.irb-header {
      background: rgba(255, 255, 255, 0.98);
      color: var(--header-foreground);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.0784);
      z-index: 60;
      width: 100%;
      position: relative;
    }
    header.header--sticky {
      position: sticky;
      top: 0;
    }
    header.header--overlay {
      position: sticky;
      top: 0;
    }
    body:not(.irb-subview-active) header.header--overlay {
      margin-bottom: calc(-1 * var(--irb-header-height, 76px));
    }
    .headerContent {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 0;
    }
    .headerContent--layout-2 { flex-direction: column; gap: 10px; }
    .headerLeftGroup { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .headerMenuBtn {
      display: none;
      background: transparent;
      border: none;
      color: var(--header-foreground);
      padding: 6px;
      cursor: pointer;
    }
    .headerContent_logo {
      display: flex;
      align-items: center;
      text-decoration: none;
      cursor: pointer;
      opacity: 1;
      position: relative;
      z-index: 2;
    }
    .headerContent_logo_img {
      max-height: 46px;
      max-width: 210px;
      object-fit: contain;
      opacity: 1;
      display: block;
    }
    .headerContent_logo_text {
      font-family: var(--title-font-family);
      font-size: 24px;
      font-weight: 700;
      color: var(--header-foreground);
      opacity: 1;
    }
    .headerContent_navInline {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex: 1 1 auto;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0 12px;
    }
    .headerContent_navInline::-webkit-scrollbar { display: none; }
    .headerContent_actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .headerIconBtn {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: transparent;
      color: var(--header-foreground);
      border: none;
      border-radius: 999px;
      padding: 0;
      cursor: pointer;
      transition: background .15s ease, opacity .15s ease;
    }
    .headerIconBtn:hover { background: rgba(0, 0, 0, 0.06); }
    .headerIconBtn.is-active { background: rgba(0, 0, 0, 0.09); }
    .cartCountBadge {
      position: absolute;
      top: 3px;
      right: 2px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 17px;
      height: 17px;
      padding: 0 4px;
      border-radius: 999px;
      background: var(--primary-background);
      color: var(--primary-foreground);
      font-size: 10px;
      font-weight: 700;
      line-height: 1;
    }
    /* Dropdown Minha Conta abaixo do ícone com Blur no fundo */
    .headerAccountWrap {
      position: relative;
      display: inline-flex;
      align-items: center;
    }
    .irb-account-backdrop {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: rgba(15, 23, 42, 0.18);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      display: none;
    }
    .irb-account-backdrop.open { display: block; }
    .irb-account-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 215px;
      padding: 8px;
      border-radius: calc(var(--irb-radius) + 4px);
      background: rgba(255, 255, 255, 0.86);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.65);
      box-shadow: 0 20px 44px rgba(15, 23, 42, 0.2);
      z-index: 90;
      display: none;
      flex-direction: column;
      gap: 6px;
      animation: irbPopIn .16s ease-out;
    }
    .irb-account-dropdown.open { display: flex; }
    .irb-account-dropdown__item {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: var(--irb-radius);
      font-family: var(--text-font-family);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      text-align: left;
      transition: transform .12s ease, opacity .15s ease, background .15s ease;
    }
    .irb-account-dropdown__item--primary {
      background: var(--btn-primary-background);
      color: var(--btn-primary-color);
      border: 1px solid var(--btn-primary-border);
    }
    .irb-account-dropdown__item--primary:hover { opacity: 0.92; }
    .irb-account-dropdown__item--secondary {
      background: rgba(17, 24, 39, 0.05);
      color: #111827;
      border: 1px solid rgba(17, 24, 39, 0.12);
    }
    .irb-account-dropdown__item--secondary:hover { background: rgba(17, 24, 39, 0.1); }
    .irb-account-dropdown__plus {
      width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      font-weight: 700;
      line-height: 1;
    }
    /* Pop-up Modal de Pesquisa (Padrão Tema LIME) */
    .irb-search-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.56);
      backdrop-filter: blur(4px);
      z-index: 130;
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding: 72px 16px 24px;
    }
    .irb-search-modal-backdrop.open { display: flex; }
    .irb-search-modal-card {
      width: 100%;
      max-width: 640px;
      background: #ffffff;
      color: #111827;
      border-radius: calc(var(--irb-radius) + 6px);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.24);
      overflow: hidden;
      animation: irbPopIn .18s ease-out;
    }
    @keyframes irbPopIn {
      from { opacity: 0; transform: translateY(-10px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .irb-search-modal-top {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px 18px;
      border-bottom: 1px solid #e5e7eb;
    }
    .headerContent_search {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }
    .headerContent_search input {
      width: 100%;
      padding: 10px 42px 10px 14px;
      border-radius: var(--irb-radius);
      border: 1px solid #d1d5db;
      font-family: var(--text-font-family);
      font-size: 15px;
      outline: none;
      background: #f9fafb;
      color: #111827;
    }
    .headerContent_search input:focus { border-color: var(--primary-background); background: #ffffff; }
    .headerSearchSubmit {
      position: absolute;
      right: 6px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      color: #374151;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .headerSearchClose {
      border: none;
      background: #f3f4f6;
      color: #374151;
      font-size: 20px;
      line-height: 1;
      width: 36px;
      height: 36px;
      border-radius: 999px;
      cursor: pointer;
      flex-shrink: 0;
    }
    .headerSearchClose:hover { background: #e5e7eb; }
    .irb-search-modal-body {
      padding: 16px 18px 20px;
      max-height: 60vh;
      overflow-y: auto;
    }
    .irb-search-results { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
    .irb-search-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px;
      border-radius: var(--irb-radius);
      border: 1px solid #f3f4f6;
      background: #ffffff;
      cursor: pointer;
      text-align: left;
      width: 100%;
      transition: background .15s, border-color .15s;
    }
    .irb-search-item:hover { background: #f9fafb; border-color: #d1d5db; }
    .irb-search-item img { width: 46px; height: 46px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
    .headerContent_categories {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      padding: 10px 0 14px;
      border-top: 1px solid rgba(0, 0, 0, 0.0588);
    }
    .categoryLink {
      text-decoration: none;
      color: var(--header-foreground);
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
      flex-shrink: 0;
      padding: 2px 0;
      border-radius: 0;
      transition: color .16s ease, background-color .16s ease, box-shadow .16s ease, opacity .16s ease;
      cursor: pointer;
    }
    .categoryLink:hover, .categoryLink.active {
      color: var(--header-link-hover-color);
      opacity: 1;
      text-decoration: underline; text-underline-offset: 5px;
    }

    @media (max-width: 900px) {
      .headerMenuBtn { display: inline-flex; flex-shrink: 0; }
      .headerContent_navInline, .headerContent_categories { display: none; }
      .headerLeftGroup { min-width: 0; flex: 1 1 auto; }
      .headerContent_logo { min-width: 0; max-width: 100%; }
      .headerContent_logo_text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    }
    @media (max-width: 640px) {
      .container { padding: 0 12px; }
      .headerContent { gap: 8px; padding: 10px 0; }
      .headerLeftGroup { gap: 6px; min-width: 0; flex: 1 1 auto; }
      .headerContent_logo { min-width: 0; max-width: 100%; }
      .headerContent_logo_img { max-height: 34px; max-width: 128px; }
      .headerContent_logo_text { font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .headerContent_actions { gap: 2px; flex-shrink: 0; }
      .headerIconBtn { width: 34px; height: 34px; }
    }

    /* Views Control */
    .storeView { display: none; }
    .storeView.active { display: block; }

    /* Breadcrumb */
    .irb-breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      padding: 18px 0 10px;
      font-size: 12px;
      color: #6b7280;
    }
    .irb-breadcrumb a, .irb-breadcrumb button {
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      color: #4b5563;
      cursor: pointer;
      text-decoration: none;
    }
    .irb-breadcrumb a:hover, .irb-breadcrumb button:hover {
      color: var(--primary-background);
      text-decoration: underline;
    }

    /* Página de Categoria (.pageLayout--category) + Filtro Lateral Esquerdo Irroba */
    .categoryHeroHeader {
      background: var(--neutral-background);
      color: var(--neutral-foreground);
      border-radius: var(--irb-radius);
      padding: 24px;
      margin: 8px 0 22px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .pageContent--category {
      display: grid;
      grid-template-columns: 264px minmax(0, 1fr);
      gap: 28px;
      align-items: start;
      padding-bottom: 56px;
    }
    .pageColumnLeft.categorySidebar {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: var(--irb-radius);
      padding: 16px;
      position: sticky;
      top: calc(var(--irb-header-height, 72px) + 16px);
    }
    .categorySidebar__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 12px;
      margin-bottom: 12px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    .categorySidebar__close {
      display: none;
      border: none;
      background: #f3f4f6;
      color: #111827;
      width: 30px;
      height: 30px;
      border-radius: 999px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .irb-active-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }
    .irb-active-filter-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--neutral-background);
      color: var(--neutral-foreground);
      font-size: 11px;
      font-weight: 600;
      border: 1px solid rgba(0, 0, 0, 0.1);
      cursor: pointer;
    }
    .filters {
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      padding: 12px 0;
    }
    .filters:last-of-type { border-bottom: none; }
    .filters summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
      font-size: 13px;
      font-weight: 700;
      color: #111827;
    }
    .filters summary::-webkit-details-marker { display: none; }
    .filter-title { font-size: 13px; font-weight: 700; color: #111827; }
    .filterSidebarList {
      list-style: none;
      padding: 10px 0 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .filterSidebarBtn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 7px 10px;
      border-radius: calc(var(--irb-radius) * 0.75);
      border: 1px solid transparent;
      background: transparent;
      color: #374151;
      font-size: 13px;
      text-align: left;
      cursor: pointer;
      transition: background .15s, color .15s;
    }
    .filterSidebarBtn:hover { background: #f3f4f6; color: #111827; }
    .filterSidebarBtn.active {
      background: var(--primary-background);
      color: var(--primary-foreground);
      font-weight: 700;
    }
    .filterSidebarCount {
      font-size: 11px;
      opacity: 0.72;
      font-variant-numeric: tabular-nums;
    }
    .filterPricePresets {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }
    .filterPresetBtn {
      padding: 4px 8px;
      border-radius: 999px;
      border: 1px solid #d1d5db;
      background: #ffffff;
      color: #374151;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
    }
    .filterPresetBtn.active {
      background: var(--primary-background);
      color: var(--primary-foreground);
      border-color: var(--primary-background);
    }
    .range_inputs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 10px;
    }
    .range_inputs label { display: block; font-size: 11px; color: #6b7280; margin-bottom: 3px; }
    .price-input {
      width: 100%;
      padding: 7px 9px;
      border-radius: var(--irb-radius);
      border: 1px solid #d1d5db;
      font-size: 12px;
      color: #111827;
      background: #ffffff;
    }
    .filterSizeGrid {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }
    .filterSizeChip {
      padding: 5px 10px;
      border-radius: var(--irb-radius);
      border: 1px solid #d1d5db;
      background: #ffffff;
      color: #374151;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .filterSizeChip.active {
      background: var(--primary-background);
      color: var(--primary-foreground);
      border-color: var(--primary-background);
    }
    .filterCheckboxLabel {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
      font-size: 13px;
      color: #374151;
      cursor: pointer;
    }
    .filterActionContainer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding-top: 14px;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
      margin-top: 6px;
    }
    .filter-button {
      padding: 9px 12px;
      border: 1px solid var(--btn-primary-border);
      border-radius: var(--irb-radius);
      background: var(--btn-primary-background);
      color: var(--btn-primary-color);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .clear-filters {
      padding: 9px 12px;
      border: 1px solid #d1d5db;
      border-radius: var(--irb-radius);
      background: #ffffff;
      color: #374151;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .pageControls--category {
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    .toolbar-shop {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .toolbar-shop-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .customFilterV2-toggle {
      display: none;
      align-items: center;
      gap: 7px;
      padding: 8px 14px;
      border-radius: var(--irb-radius);
      border: 1px solid var(--btn-primary-border);
      background: var(--btn-primary-background);
      color: var(--btn-primary-color);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
    .toolbar-shop-sorter {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: #4b5563;
    }
    .js-changeGrid {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: var(--irb-radius);
      border: 1px solid #d1d5db;
      background: #ffffff;
      color: #6b7280;
      cursor: pointer;
    }
    .js-changeGrid.active {
      border-color: var(--primary-background);
      color: var(--primary-background);
      background: #f9fafb;
    }
    .catFilterChips { display: flex; flex-wrap: wrap; gap: 8px; }
    .catFilterChip {
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid #d1d5db;
      background: #ffffff;
      color: #374151;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .catFilterChip.active {
      background: var(--primary-background);
      color: var(--primary-foreground);
      border-color: var(--primary-background);
    }
    .categorySortSelect {
      padding: 8px 12px;
      border-radius: var(--irb-radius);
      border: 1px solid #d1d5db;
      font-size: 13px;
      background: #ffffff;
      color: #111827;
    }
    .productList__grid.productList--category {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .productList__grid.productList--category.grid-cols-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .irb-cat-filter-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 105;
      background: rgba(17, 24, 39, 0.55);
    }
    .irb-cat-filter-backdrop.open { display: block; }
    @media (max-width: 960px) {
      .pageContent--category { grid-template-columns: 1fr; }
      .customFilterV2-toggle { display: inline-flex; }
      .toolbar-shop-sorter { display: none; }
      .pageColumnLeft.categorySidebar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: min(340px, 88vw);
        z-index: 112;
        border-radius: 0;
        overflow-y: auto;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.25);
      }
      .pageColumnLeft.categorySidebar.open { display: block; }
      .categorySidebar__close { display: inline-flex; }
      .productList__grid.productList--category,
      .productList__grid.productList--category.grid-cols-4 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }
    }

    /* Página Completa de Produto (PDP .product-content) */
    .pdpGrid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 36px;
      padding: 16px 0 48px;
      align-items: start;
    }
    @media (max-width: 820px) { .pdpGrid { grid-template-columns: 1fr; gap: 22px; } }
    .pdpGallery {
      display: flex;
      flex-direction: row;
      gap: 12px;
    }
    .pdpThumbs {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex-shrink: 0;
    }
    .pdpThumb {
      width: 68px;
      height: 68px;
      border-radius: var(--irb-radius);
      border: 2px solid transparent;
      overflow: hidden;
      cursor: pointer;
      background: #f9fafb;
      padding: 0;
    }
    .pdpThumb.active { border-color: var(--primary-background); }
    .pdpThumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pdpMainImageWrap {
      flex: 1;
      background: #f9fafb;
      border-radius: var(--irb-radius);
      border: 1px solid rgba(0, 0, 0, 0.06);
      overflow: hidden;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .pdpMainImageWrap img { width: 100%; height: 100%; object-fit: contain; transition: transform .3s ease; }
    .pdpMainImageWrap:hover img { transform: scale(1.04); }
    .productInfo__title { font-size: clamp(22px, 3vw, 30px); line-height: 1.2; margin: 6px 0 10px; }
    .pdpRating { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #4b5563; margin-bottom: 16px; }
    .pdpPriceBox {
      background: var(--neutral-background);
      color: var(--neutral-foreground);
      padding: 16px 18px;
      border-radius: var(--irb-radius);
      margin-bottom: 18px;
    }
    .pdpSizeList { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .pdpSizeBtn {
      min-width: 44px;
      height: 38px;
      padding: 0 12px;
      border-radius: var(--irb-radius);
      border: 1px solid #d1d5db;
      background: #ffffff;
      color: #111827;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
    }
    .pdpSizeBtn.active {
      background: var(--primary-background);
      color: var(--primary-foreground);
      border-color: var(--primary-background);
    }
    .pdpBuyRow { display: flex; gap: 10px; margin: 18px 0; }
    .pdpQtyBox {
      display: inline-flex;
      align-items: center;
      border: 1px solid #d1d5db;
      border-radius: var(--irb-radius);
      overflow: hidden;
      background: #ffffff;
    }
    .pdpQtyBox button {
      width: 36px;
      height: 46px;
      border: none;
      background: transparent;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      color: #111827;
    }
    .pdpQtyBox span { min-width: 32px; text-align: center; font-weight: 700; font-size: 14px; }
    .pdpShippingBox {
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: var(--irb-radius);
      padding: 14px;
      margin-bottom: 18px;
    }

    /* Carrossel Hero (.bannerModule) */
    .bannerModule { position: relative; width: 100%; overflow: hidden; }
    .heroSlide { display: none; width: 100%; }
    .heroSlide.active { display: block; }
    .heroSlide__artLink { display: block; width: 100%; }
    .heroSlide__artImg {
      width: 100%;
      height: auto;
      max-height: 540px;
      object-fit: cover;
      display: block;
      border-radius: 0px;
    }
    .heroNavBtn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      width: 40px;
      height: 40px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.4);
      background: rgba(17,24,39,0.55);
      color: #ffffff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .heroNavBtn.prev { left: 16px; }
    .heroNavBtn.next { right: 16px; }
    .heroDots {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      gap: 8px;
    }
    .heroDot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      border: none;
      background: rgba(255,255,255,0.5);
      cursor: pointer;
      padding: 0;
    }
    .heroDot.active { background: #ffffff; width: 24px; }

    .bannerHero {
      position: relative;
      min-height: 430px;
      
      display: flex;
      align-items: center;
      background: #111827;
      overflow: hidden;
      border-radius: 0px;
    }
    .bannerHero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.7; }
    .bannerHero__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(17,24,39,0.82) 0%, rgba(17,24,39,0.35) 60%, rgba(17,24,39,0.1) 100%);
    }
    .bannerHero__content { position: relative; z-index: 2; max-width: 640px; padding: 56px 28px; color: #ffffff; }
    .bannerHero__tag {
      display: inline-block;
      background: var(--primary-background);
      color: var(--primary-foreground);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 5px 10px;
      border-radius: var(--irb-radius);
      margin-bottom: 14px;
    }
    .bannerHero__title { font-size: clamp(28px, 4vw, 46px); line-height: 1.12; margin: 0 0 14px; font-weight: 700; }
    .bannerHero__subtitle { font-size: 16px; line-height: 1.5; margin: 0 0 24px; color: rgba(255,255,255,0.92); }
    .bannerHero__cta {
      display: inline-block;
      background: var(--btn-primary-background);
      color: var(--btn-primary-color);
      border: 1px solid var(--btn-primary-border);
      text-decoration: none;
      padding: 14px 28px;
      font-weight: 700;
      font-size: 14px;
      border-radius: var(--irb-radius);
    }

    /* Secondary Editorial Banner */
    .secondaryEditorial { border-radius: var(--irb-radius); overflow: hidden; display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; }
    .secondaryEditorial__text { padding: 44px 40px; }
    .secondaryEditorial__media { height: 100%; min-height: 300px; max-height: 380px; overflow: hidden; }
    .secondaryEditorial__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .btnSecondaryCustom {
      display: inline-block;
      padding: 13px 26px;
      border-radius: var(--irb-radius);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      background: transparent;
      color: inherit;
      border: 2px solid currentColor;
    }

    /* Listas de Produtos (.productList) */
    .productList { padding: 46px 0; }
    .productList__header { margin-bottom: 26px; }
    .productList__title { font-size: 28px; margin: 0 0 6px; font-weight: 700; }
    .productList__subtitle { margin: 0; color: #6b7280; font-size: 14px; }
    .productList__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
    @media (max-width: 1024px) { .productList__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 720px) {
      .productList__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .bannerHero { min-height: 340px; }
      .secondaryEditorial { grid-template-columns: 1fr; }
      .secondaryEditorial__text { padding: 28px 22px; }
    }
    .product.product-grid {
      background: var(--productGrid-background);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: var(--irb-radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .product.product-grid:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08); }
    .product-image-wrap {
      position: relative;
      aspect-ratio: 1 / 1;
      background: #f9fafb;
      overflow: hidden;
      cursor: pointer;
    }
    .product-image-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
    .product.product-grid:hover .product-image-wrap img { transform: scale(1.04); }
    .product-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: var(--primary-background);
      color: var(--primary-foreground);
      font-size: 11px;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: var(--irb-radius);
      z-index: 2;
    }
    .product-info {
      padding: 14px var(--productGrid-information-padding-x) 16px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .product-cat { font-size: 11px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
    .product-title {
      font-family: var(--text-font-family);
      font-size: 14px;
      font-weight: 600;
      line-height: 1.35;
      margin: 0 0 10px;
      cursor: pointer;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .product-price-wrap { display: flex; align-items: baseline; gap: 8px; margin-top: auto; }
    .product-price-old { font-size: 12px; color: var(--product-old-price-color); text-decoration: line-through; }
    .product-price { font-size: 17px; font-weight: 700; color: var(--product-price-color); }
    .product-installments { font-size: 11px; color: #4b5563; margin-top: 3px; margin-bottom: 12px; }
    .product-btn {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--productList-buy-btn-border);
      border-radius: var(--irb-radius);
      background: var(--productList-buy-btn-background);
      color: var(--productList-buy-btn-foreground);
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: opacity .15s;
    }
    .product-btn:hover { opacity: 0.9; }

    /* Depoimentos (.reviewModule) */
    .reviewModule { padding: 46px 0; background: var(--neutral-background); color: var(--neutral-foreground); }
    .reviewGrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    @media (max-width: 768px) { .reviewGrid { grid-template-columns: 1fr; } }
    .reviewCard { background: #ffffff; color: #111827; padding: 22px; border-radius: var(--irb-radius); border: 1px solid rgba(0, 0, 0, 0.06); }
    .reviewCard__stars { color: #f59e0b; font-size: 16px; margin-bottom: 8px; }
    .reviewCard__text { font-size: 14px; line-height: 1.5; color: #374151; margin: 0 0 12px; }
    .reviewCard__author { font-size: 13px; font-weight: 700; color: #111827; }

    /* Newsletter (.newsletterModule) */
    .newsletterModule { padding: 44px 0; background: var(--body-background); border-top: 1px solid rgba(0, 0, 0, 0.06); }
    .newsletterBox {
      background: var(--neutral-background);
      color: var(--neutral-foreground);
      border-radius: var(--irb-radius);
      padding: 32px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .newsletterForm { display: flex; gap: 10px; flex: 1 1 320px; max-width: 460px; }
    .newsletterForm input { flex: 1; padding: 12px 14px; border-radius: var(--irb-radius); border: 1px solid #d1d5db; font-size: 14px; }
    .newsletterForm button {
      background: var(--btn-primary-background);
      color: var(--btn-primary-color);
      border: 1px solid var(--btn-primary-border);
      padding: 12px 20px;
      border-radius: var(--irb-radius);
      font-weight: 700;
      cursor: pointer;
    }

    /* Rodapé Padrão Tema LIME Irroba */
    .footerContent--top { background: var(--footer-background); color: var(--footer-foreground); padding: 48px 0 42px; }
    .footerGrid {
      display: grid;
      grid-template-columns: 1.25fr 0.85fr 0.9fr 1.1fr;
      gap: 36px;
      align-items: start;
    }
    .footerTitle {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin: 0 0 14px;
    }
    .footerText { font-size: 13.5px; line-height: 1.65; opacity: 0.84; margin: 0 0 18px; }
    .footerSocialTitle { margin-top: 6px; margin-bottom: 10px; font-size: 12px; }
    .footer-social-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .footer-social-item a.icon {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 13px;
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, currentColor 26%, transparent);
      background: color-mix(in srgb, currentColor 8%, transparent);
      color: inherit;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      transition: background .15s ease, transform .15s ease;
    }
    .footer-social-item a.icon:hover {
      background: color-mix(in srgb, currentColor 18%, transparent);
      transform: translateY(-1px);
    }
    .footerSummary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .footerSummary::-webkit-details-marker { display: none; }
    .footerSummary .footerTitle { margin: 0; }
    .footerSummary__chevron { display: none; opacity: 0.8; transition: transform .2s ease; }
    @media (min-width: 769px) {
      .footerSummary { pointer-events: none; cursor: default; }
    }
    @media (max-width: 960px) {
      .footerGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
    }
    @media (max-width: 768px) {
      .footerGrid { grid-template-columns: 1fr; gap: 0; }
      .footerContent__info--store { padding-bottom: 20px; border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent); }
      details.footerContent__info { border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent); padding: 14px 0; }
      .footerSummary { margin-bottom: 0; cursor: pointer; }
      .footerSummary__chevron { display: inline-flex; }
      details.footerContent__info[open] .footerSummary__chevron { transform: rotate(180deg); }
      details.footerContent__info .footerList { padding-top: 12px; }
    }
    .footerList { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; font-size: 13.5px; }
    .footerList a { color: inherit; text-decoration: none; opacity: 0.84; cursor: pointer; }
    .footerList a:hover { opacity: 1; text-decoration: underline; }
    .service__list__item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      line-height: 1.5;
      opacity: 0.88;
    }
    .service__list__item svg { flex-shrink: 0; margin-top: 2px; opacity: 0.85; }
    .footer-address-info address { font-style: normal; }
    .footerContent--bottom {
      background: #ffffff;
      color: #111827;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
      padding: 26px 0;
    }
    .footerSealsLayout {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: start;
    }
    .footerSealsLayout--1 { grid-template-columns: 1fr; }
    .footerSealsLayout--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (max-width: 820px) {
      .footerSealsLayout { grid-template-columns: 1fr; gap: 18px; }
    }
    .sealsList__item { display: flex; flex-direction: column; gap: 10px; }
    .sealsList__title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #374151;
    }
    .sealsList { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .sealsList svg { max-width: 100%; height: auto; display: block; }
    .footer-legal-info {
      background: var(--footerLegal-background);
      color: var(--footerLegal-foreground);
      padding: 18px 0;
      font-size: 12px;
    }
    .footerLegalInner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px 24px;
    }
    .platform-info {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      opacity: 0.9;
    }
    .platform-info .irroba-logo a {
      color: inherit;
      display: inline-flex;
      align-items: center;
      text-decoration: none;
    }
    .store-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      text-align: right;
      margin-left: auto;
      opacity: 0.9;
    }
    .footer-company-info__text { display: inline-flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; font-weight: 600; }
    .footer-copyright { display: inline-flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
    @media (max-width: 768px) {
      .footerLegalInner { flex-direction: column; align-items: flex-start; }
      .store-info { text-align: left; margin-left: 0; }
      .footer-company-info__text, .footer-copyright { justify-content: flex-start; }
    }

    /* Drawers & Account Modal */
    .irb-drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, 0.55);
      z-index: 110;
      display: none;
      justify-content: flex-end;
    }
    .irb-drawer-backdrop.open { display: flex; }
    .irb-drawer-backdrop.left { justify-content: flex-start; }
    .irb-drawer-panel {
      width: 100%;
      max-width: 390px;
      background: #ffffff;
      color: #111827;
      height: 100%;
      display: flex;
      flex-direction: column;
      padding: 20px;
    }
    .mobileNavLink {
      display: block;
      padding: 12px 4px;
      border-bottom: 1px solid #f3f4f6;
      color: #111827;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
    }
    .irb-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, 0.65);
      z-index: 120;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .irb-modal-backdrop.open { display: flex; }
  </style>
</head>
<body class="page-common-home common-home theme-_lime">
  <div class="overlineModule">Frete Grátis em compras selecionadas • 5% OFF no PIX • Parcele em até 6x sem juros</div>

  <div class="irb-account-backdrop" id="irb-account-backdrop" aria-hidden="true"></div>

  <header class="irb-header ">
    <div class="container">
      <div class="headerContent headerContent--layout-1">
        <div class="headerLeftGroup">
          <button type="button" class="headerMenuBtn" id="irb-open-mobile-menu" aria-label="Abrir menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
          <a href="#home" class="headerContent_logo" id="irb-go-home-logo"><img src="https://cdn.example.com/logo.png" alt="Fit Sup" class="headerContent_logo_img" /></a>
        </div>

        <nav class="headerContent_navInline" aria-label="Categorias">
          <a href="#categoria" class="categoryLink" data-filter-cat="Categoria A">Categoria A</a><a href="#categoria" class="categoryLink" data-filter-cat="Categoria B">Categoria B</a>
        </nav>

        <div class="headerContent_actions">
          <button type="button" class="headerIconBtn" id="irb-toggle-search" aria-label="Pesquisar" title="Pesquisar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
          <div class="headerAccountWrap" id="irb-account-wrap">
            <button type="button" class="headerIconBtn" id="irb-open-account" aria-label="Minha Conta" aria-expanded="false" aria-haspopup="menu" title="Minha Conta">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </button>
            <div class="irb-account-dropdown" id="irb-account-dropdown" role="menu" aria-label="Opções da conta">
              <button type="button" class="irb-account-dropdown__item irb-account-dropdown__item--primary" data-account-action="login" role="menuitem">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>Entrar</span>
              </button>
              <button type="button" class="irb-account-dropdown__item irb-account-dropdown__item--secondary" data-account-action="register" role="menuitem">
                <span class="irb-account-dropdown__plus">+</span>
                <span>Criar conta</span>
              </button>
            </div>
          </div>
          <button type="button" class="headerIconBtn" id="irb-open-cart" aria-label="Sacola" title="Sacola">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="cartCountBadge" id="irb-cart-count">0</span>
          </button>
        </div>
      </div>

      
    </div>
  </header>

  <!-- Pop-up Modal de Pesquisa (Padrão Tema LIME) -->
  <div class="irb-search-modal-backdrop" id="irb-search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Pesquisar na loja">
    <div class="irb-search-modal-card" id="irb-search-modal-card">
      <div class="irb-search-modal-top">
        <form class="headerContent_search" id="irb-search-form">
          <input type="search" id="irb-search-input" placeholder="O que você está procurando?" aria-label="Buscar produtos" autocomplete="off" />
          <button type="submit" class="headerSearchSubmit" aria-label="Pesquisar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
        </form>
        <button type="button" class="headerSearchClose" id="irb-close-search" aria-label="Fechar busca">&times;</button>
      </div>
      <div class="irb-search-modal-body">
        <div style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#6b7280;margin-bottom:8px;">Categorias populares</div>
        <div class="catFilterChips" style="margin-bottom:14px;"><button type="button" class="catFilterChip" data-filter-cat="Categoria A">Categoria A</button><button type="button" class="catFilterChip" data-filter-cat="Categoria B">Categoria B</button></div>
        <div id="irb-search-live-title" style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#6b7280;">Sugestões em destaque</div>
        <div class="irb-search-results" id="irb-search-live-results"></div>
      </div>
    </div>
  </div>

  <main>
    <!-- 1. VIEW: PÁGINA INICIAL (Ordem dinâmica controlada pelo Editor de Seções) -->
    <div id="irb-view-home" class="storeView active">
      <section class="bannerModule" data-irb-section="hero">
        <div class="" style="position:relative;">
          <div class="heroSlide active" data-slide-idx="0">
  <a href="#vitrines" class="heroSlide__artLink">
    <img class="heroSlide__artImg" src="https://cdn.example.com/hero.jpg" alt="Hero" />
  </a>
</div>
          
        </div>
      </section>
      <section class="bannerTarjaModule" id="bannerTarja-benefits" data-irb-section="tarja">
        <div class="container"><div style="position:relative;left:50%;width:100vw;max-width:100vw;margin-left:-50vw;background:#ECEDEE;padding:14px 16px;box-sizing:border-box;">
