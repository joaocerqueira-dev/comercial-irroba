    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0.52) 0%,rgba(0,0,0,0.16) 24%,rgba(0,0,0,0.03) 48%,rgba(0,0,0,0.82) 100%);"></div>
    <div style="position:absolute;top:18px;left:18px;right:18px;display:flex;align-items:center;justify-content:space-between;gap:8px;">
      <span style="font-size:10px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.92);padding:5px 10px;border:1px solid rgba(255,255,255,0.3);border-radius:999px;background:rgba(0,0,0,0.22);">02 / 02</span>
      <span style="font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.92);background:rgba(0,0,0,0.3);padding:4px 9px;border-radius:999px;">Ver modelos</span>
    </div>
    <div style="position:absolute;left:22px;right:22px;bottom:22px;color:#ffffff;">
      <div style="font-family:'Oswald',sans-serif;font-size:clamp(21px,2.1vw,27px);font-weight:400;line-height:1.1;letter-spacing:-0.01em;margin:0 0 12px 0;">Categoria B</div>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#ffffff;padding-bottom:4px;border-bottom:1px solid rgba(255,255,255,0.7);">Explorar &#8594;</span>
    </div>
  </a>
    </div>
  </div>
</div>",
      "id": "irb-html-editorial-gallery",
      "moduleTitle": "Conteúdo HTML · Galeria Editorial",
      "name": "Galeria Editorial de Coleções (3:4 + Movimento Suave)",
      "placementNote": "Posicionar em Página Inicial > Topo do Conteúdo logo após a Tarja Informativa. Usa 100% CSS inline + animação SVG SMIL nativa sem JavaScript (compatível com SunEditor).",
