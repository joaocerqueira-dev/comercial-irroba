/* Cole em: Editar tema > Código > CSS Personalizado */
.product.product-grid {
  transition: transform 0.22s ease, box-shadow 0.22s ease;
  border-radius: 24px;
}
.product.product-grid:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
}
.product-btn {
  font-weight: 600;
  letter-spacing: 0.02em;
  border-radius: 24px;
  border: 1px solid transparent;
}
.htmlContent a {
  transition: transform 0.35s ease, opacity 0.25s ease;
}
.htmlContent a:hover img {
  transform: scale(1.04);
}",
  "htmlBlocks": [
    {
      "html": "<div style="position:relative;left:50%;width:100vw;max-width:100vw;margin-left:-50vw;background:#0B0B0F;color:#EEEEEE;padding:clamp(46px,6vw,78px) clamp(20px,4vw,52px);box-sizing:border-box;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:clamp(28px,3.8vw,44px);">
      <div style="flex:1 1 380px;">
        <div style="display:inline-flex;align-items:center;gap:10px;font-size:11px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;opacity:0.68;margin-bottom:12px;">
          <span style="display:inline-block;width:28px;height:1px;background:#F5D90A;"></span>
          <span>Curadoria · Tecnologia &amp; Eletrônicos</span>
        </div>
        <h2 style="margin:0;font-family:'Oswald',sans-serif;font-size:clamp(30px,4vw,50px);font-weight:300;line-height:1.02;letter-spacing:-0.02em;color:#EEEEEE;">Explore por Estilo &amp; <em style="font-style:italic;font-weight:400;color:#F5D90A;">Categoria</em></h2>
      </div>
      <div style="flex:0 1 340px;">
        <p style="margin:0 0 14px 0;font-size:14px;line-height:1.65;opacity:0.78;">Seleção editorial pensada para destacar as principais linhas da Gamer Tech com navegação fluida em qualquer tela.</p>
        <a href="#categoria" data-irb-cat="all" style="display:inline-block;font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#EEEEEE;text-decoration:none;padding-bottom:4px;border-bottom:1px solid #EEEEEE;">Ver catálogo completo &#8594;</a>
      </div>
    </div>
    <div style="display:flex;gap:clamp(14px,1.8vw,22px);overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px;scrollbar-width:thin;">
