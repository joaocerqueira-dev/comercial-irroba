  <div style="margin:0 calc(-1 * clamp(20px,4vw,52px));background:#18181B;color:#FFFFFF;padding:clamp(34px,4.5vw,54px) clamp(20px,4vw,52px);box-sizing:border-box;">
    <div style="max-width:1280px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:22px;">
