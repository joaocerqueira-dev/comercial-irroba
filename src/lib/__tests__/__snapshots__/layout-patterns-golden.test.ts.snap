          </span>
        </span>
        <span class="store-info">
          
          <span class="footer-copyright">
            <span class="footer-copyright__text">© 2025 Joias Lux. Todos os direitos reservados.</span>
            
          </span>
        </span>
      </div>
    </div>
  </footer>

  <!-- Mobile Navigation Drawer -->
  <div id="irb-mobile-drawer" class="irb-drawer-backdrop left" role="dialog" aria-modal="true">
    <div class="irb-drawer-panel">
      <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:14px;border-bottom:1px solid #e5e7eb;">
        <strong style="font-size:17px;">Menu da Loja</strong>
        <button type="button" id="irb-mobile-close" style="border:none;background:#f3f4f6;width:32px;height:32px;border-radius:999px;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
      </div>
      <div style="padding:10px 0;overflow-y:auto;">
        <a href="#categoria" class="mobileNavLink" data-filter-cat="Categoria A">Categoria A</a><a href="#categoria" class="mobileNavLink" data-filter-cat="Categoria B">Categoria B</a>
      </div>
    </div>
  </div>

  <!-- Account Modal (Demo: Entrar & Criar conta) -->
  <div id="irb-account-modal" class="irb-modal-backdrop" role="dialog" aria-modal="true">
    <div style="background:#ffffff;color:#111827;max-width:400px;width:100%;border-radius:12px;padding:24px;position:relative;">
      <button type="button" id="irb-account-close" style="position:absolute;top:14px;right:14px;border:none;background:#f3f4f6;width:30px;height:30px;border-radius:999px;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <h3 id="irb-account-modal-title" style="margin:0;font-size:19px;">Entrar na sua conta</h3>
      </div>
      <p id="irb-account-modal-desc" style="margin:0 0 16px;font-size:13px;color:#4b5563;">Acesse seus pedidos, favoritos e dados cadastrais no ambiente seguro da Irroba.</p>
      <form id="irb-account-form" onsubmit="event.preventDefault(); document.getElementById('irb-account-msg').style.display='block';">
        <input type="text" id="irb-account-name-field" placeholder="Seu nome completo" style="display:none;width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;margin-bottom:10px;font-size:14px;" />
        <input type="email" required placeholder="Seu e-mail" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;margin-bottom:10px;font-size:14px;" />
        <input type="password" required placeholder="Sua senha" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;margin-bottom:14px;font-size:14px;" />
        <button type="submit" id="irb-account-submit-btn" class="product-btn" style="padding:12px;">Entrar na Conta (Demo)</button>
      </form>
      <div id="irb-account-msg" style="display:none;margin-top:12px;padding:10px;border-radius:8px;background:#ecfdf5;color:#065f46;font-size:12px;font-weight:600;">
        Ação de demonstração validada com sucesso!
      </div>
    </div>
  </div>

  <!-- Mini-Carrinho Lateral -->
  <div id="irb-cart-drawer" class="irb-drawer-backdrop" role="dialog" aria-modal="true">
    <div class="irb-drawer-panel">
      <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:14px;border-bottom:1px solid #e5e7eb;">
        <div style="display:flex;align-items:center;gap:8px;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <strong style="font-size:18px;">Sua Sacola</strong>
        </div>
        <button type="button" id="irb-cart-close" style="border:none;background:#f3f4f6;width:32px;height:32px;border-radius:999px;cursor:pointer;display:flex;align-items:center;justify-content:center;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
      </div>
      <div id="irb-cart-items" style="flex:1;overflow-y:auto;padding:14px 0;display:flex;flex-direction:column;gap:12px;"></div>
      <div style="border-top:1px solid #e5e7eb;padding-top:14px;">
        <div style="display:flex;justify-content:space-between;font-size:16px;font-weight:700;margin-bottom:12px;">
          <span>Subtotal</span>
          <span id="irb-cart-total">R$ 0,00</span>
        </div>
        <button type="button" onclick="alert('Checkout Transparente Irroba pronto para conversão!')" class="product-btn" style="padding:14px;font-size:14px;">Finalizar Compra (Demo)</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const PRODUCTS = [{"id":"p0","title":"Produto 0","price":100,"imageUrl":"https://cdn.example.com/p0.jpg","images":["https://cdn.example.com/p0.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 16,67 sem juros","description":"Produto 0 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p1","title":"Produto 1","price":101,"imageUrl":"https://cdn.example.com/p1.jpg","images":["https://cdn.example.com/p1.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 16,83 sem juros","description":"Produto 1 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p2","title":"Produto 2","price":102,"imageUrl":"https://cdn.example.com/p2.jpg","images":["https://cdn.example.com/p2.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 17,00 sem juros","description":"Produto 2 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p3","title":"Produto 3","price":103,"imageUrl":"https://cdn.example.com/p3.jpg","images":["https://cdn.example.com/p3.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 17,17 sem juros","description":"Produto 3 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p4","title":"Produto 4","price":104,"imageUrl":"https://cdn.example.com/p4.jpg","images":["https://cdn.example.com/p4.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 17,33 sem juros","description":"Produto 4 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p5","title":"Produto 5","price":105,"imageUrl":"https://cdn.example.com/p5.jpg","images":["https://cdn.example.com/p5.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 17,50 sem juros","description":"Produto 5 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p6","title":"Produto 6","price":106,"imageUrl":"https://cdn.example.com/p6.jpg","images":["https://cdn.example.com/p6.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 17,67 sem juros","description":"Produto 6 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p7","title":"Produto 7","price":107,"imageUrl":"https://cdn.example.com/p7.jpg","images":["https://cdn.example.com/p7.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 17,83 sem juros","description":"Produto 7 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p8","title":"Produto 8","price":108,"imageUrl":"https://cdn.example.com/p8.jpg","images":["https://cdn.example.com/p8.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 18,00 sem juros","description":"Produto 8 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true},{"id":"p9","title":"Produto 9","price":109,"imageUrl":"https://cdn.example.com/p9.jpg","images":["https://cdn.example.com/p9.jpg"],"category":"Categoria A","categories":["Categoria A"],"installmentsText":"em até 6x de R$ 18,17 sem juros","description":"Produto 9 selecionado especialmente para você na nova loja Joias Lux na plataforma Irroba.","visible":true}];
      const CATEGORIES = ["Categoria A","Categoria B"];
      const BUY_BTN_TEXT = "Comprar agora";
      const cart = [];
      let activeCategory = 'all';
      let searchQuery = '';
      let rawSearchQuery = '';
      let minPriceFilter = null;
      let maxPriceFilter = null;
      let promoOnlyFilter = false;
      let catGridCols = 3;
      let activePdpProduct = null;
      let activeSize = "Padrão";
      let pdpQty = 1;

      const formatCurrency = (val) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val);

      function syncHeaderHeight() {
        const hdr = document.querySelector('header.irb-header');
        if (hdr) {
          document.documentElement.style.setProperty('--irb-header-height', hdr.offsetHeight + 'px');
        }
      }
      syncHeaderHeight();
      if (typeof ResizeObserver !== 'undefined') {
        const hdr = document.querySelector('header.irb-header');
        if (hdr) new ResizeObserver(syncHeaderHeight).observe(hdr);
      }
      window.addEventListener('resize', syncHeaderHeight, { passive: true });

      // Barra de Aviso Superior — Rolagem automática mensagem por mensagem
      const overlineTicker = document.getElementById('irb-overline-ticker');
      if (overlineTicker) {
        const overlineSlides = Array.from(overlineTicker.querySelectorAll('.overlineModule__slide'));
        const intervalMs = Math.max(1000, Number(overlineTicker.getAttribute('data-interval-ms')) || 4000);
        const prefersReducedMotion =
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const slideResetTimers = new Map();
        let overlineIdx = 0;
        let overlinePaused = false;
        overlineTicker.addEventListener('mouseenter', () => { overlinePaused = true; });
        overlineTicker.addEventListener('mouseleave', () => { overlinePaused = false; });

        if (overlineSlides.length > 1) {
          setInterval(() => {
            if (overlinePaused) return;
            const prevSlide = overlineSlides[overlineIdx];
            overlineIdx = (overlineIdx + 1) % overlineSlides.length;
            const nextSlide = overlineSlides[overlineIdx];

            if (nextSlide) {
              const pending = slideResetTimers.get(nextSlide);
              if (pending) {
                clearTimeout(pending);
                slideResetTimers.delete(nextSlide);
              }
              nextSlide.classList.add('is-resetting');
              nextSlide.classList.remove('is-leaving', 'is-active');
              void nextSlide.offsetWidth;
              nextSlide.classList.remove('is-resetting');
            }

            if (prevSlide && prevSlide !== nextSlide) {
              prevSlide.classList.remove('is-active');
              if (prefersReducedMotion) {
                prevSlide.classList.remove('is-leaving');
              } else {
                prevSlide.classList.add('is-leaving');
                const timer = setTimeout(() => {
                  prevSlide.classList.add('is-resetting');
                  prevSlide.classList.remove('is-leaving');
                  void prevSlide.offsetWidth;
                  prevSlide.classList.remove('is-resetting');
                  slideResetTimers.delete(prevSlide);
                }, 540);
                slideResetTimers.set(prevSlide, timer);
              }
            }

            if (nextSlide) {
              nextSlide.classList.add('is-active');
            }
          }, intervalMs);
        }
      }

      function switchView(viewName) {
        document.getElementById('irb-view-home').classList.toggle('active', viewName === 'home');
        document.getElementById('irb-view-category').classList.toggle('active', viewName === 'category');
        document.getElementById('irb-view-product').classList.toggle('active', viewName === 'product');
        document.body.classList.toggle('irb-subview-active', viewName !== 'home');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      // Hero Carousel
      const slides = Array.from(document.querySelectorAll('.heroSlide'));
      const dots = Array.from(document.querySelectorAll('.heroDot'));
      let slideIdx = 0;
      function showSlide(nextIdx) {
        if (slides.length <= 1) return;
        slideIdx = (nextIdx + slides.length) % slides.length;
        slides.forEach((s, i) => s.classList.toggle('active', i === slideIdx));
        dots.forEach((d, i) => d.classList.toggle('active', i === slideIdx));
      }
      const prevBtn = document.getElementById('irb-hero-prev');
      const nextBtn = document.getElementById('irb-hero-next');
      if (prevBtn) prevBtn.addEventListener('click', () => showSlide(slideIdx - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => showSlide(slideIdx + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => showSlide(Number(dot.getAttribute('data-hero-dot') || 0)));
      });
      if (slides.length > 1) {
        setInterval(() => showSlide(slideIdx + 1), 6000);
      }

      function createProductCardNode(p) {
        const card = document.createElement('article');
        card.className = 'product product-grid';

        const imgWrap = document.createElement('div');
        imgWrap.className = 'product-image-wrap';
        imgWrap.addEventListener('click', () => openProductPage(p.id));

        if (p.compareAtPrice && p.compareAtPrice > p.price) {
          const pct = Math.round(((p.compareAtPrice - p.price) / p.compareAtPrice) * 100);
          if (pct > 0) {
            const badge = document.createElement('span');
            badge.className = 'product-badge';
            badge.textContent = '-' + pct + '%';
            imgWrap.appendChild(badge);
          }
        }

        const img = document.createElement('img');
        img.src = p.imageUrl;
        img.alt = p.title;
        img.loading = 'lazy';
        imgWrap.appendChild(img);

        const info = document.createElement('div');
        info.className = 'product-info';

        const catEl = document.createElement('span');
        catEl.className = 'product-cat';
        catEl.textContent = p.category || 'Destaques';
        info.appendChild(catEl);

        const titleEl = document.createElement('h3');
        titleEl.className = 'product-title';
        titleEl.textContent = p.title;
        titleEl.addEventListener('click', () => openProductPage(p.id));
        info.appendChild(titleEl);

        const priceWrap = document.createElement('div');
        priceWrap.className = 'product-price-wrap';
        if (p.compareAtPrice && p.compareAtPrice > p.price) {
          const oldEl = document.createElement('span');
          oldEl.className = 'product-price-old';
          oldEl.textContent = formatCurrency(p.compareAtPrice);
          priceWrap.appendChild(oldEl);
        }
        const priceEl = document.createElement('span');
        priceEl.className = 'product-price';
        priceEl.textContent = formatCurrency(p.price);
        priceWrap.appendChild(priceEl);
        info.appendChild(priceWrap);

        if (p.installmentsText) {
          const instEl = document.createElement('div');
          instEl.className = 'product-installments';
          instEl.textContent = p.installmentsText;
          info.appendChild(instEl);
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'product-btn';
        btn.textContent = BUY_BTN_TEXT;
        btn.addEventListener('click', () => addToCart(p.id, 1));
        info.appendChild(btn);

        card.appendChild(imgWrap);
        card.appendChild(info);
        return card;
      }

      function matchesCategory(product, catLabel) {
        if (catLabel === 'all') return true;
        const norm = catLabel.toLowerCase();
        const stem = norm.replace(/s$/, '');
        const cats = (product.categories || [product.category || '']).map((c) => c.toLowerCase());
        return (
          cats.some((c) => c.includes(norm) || norm.includes(c)) ||
          (product.title || '').toLowerCase().includes(stem)
        );
      }

      function setCatDrawerOpen(open) {
        const sidebar = document.getElementById('irb-cat-sidebar');
        const backdrop = document.getElementById('irb-cat-filter-backdrop');
        if (sidebar) sidebar.classList.toggle('open', Boolean(open));
        if (backdrop) {
          backdrop.classList.toggle('open', Boolean(open));
          backdrop.setAttribute('aria-hidden', open ? 'false' : 'true');
        }
      }

      function updateSidebarCategoryCounts() {
        document.querySelectorAll('[data-cat-count]').forEach((el) => {
          const catAttr = el.getAttribute('data-cat-count') || 'all';
          if (catAttr === 'all') {
            el.textContent = String(PRODUCTS.length);
            return;
          }
          const matchedCount = PRODUCTS.filter((p) => matchesCategory(p, catAttr)).length;
          el.textContent = String(matchedCount);
        });
      }
      updateSidebarCategoryCounts();

      function syncPricePresetButtons() {
        document.querySelectorAll('#irb-price-presets .filterPresetBtn').forEach((btn) => {
          const pMinRaw = btn.getAttribute('data-price-min') || '';
          const pMaxRaw = btn.getAttribute('data-price-max') || '';
          const pMin = pMinRaw ? Number(pMinRaw) : null;
          const pMax = pMaxRaw ? Number(pMaxRaw) : null;
          btn.classList.toggle('active', minPriceFilter === pMin && maxPriceFilter === pMax);
        });
      }

      function renderActiveFilterTags() {
        const wrap = document.getElementById('irb-active-filters');
        const badge = document.getElementById('irb-cat-filter-badge');
        let activeCount = 0;
        const tags = [];
        if (activeCategory !== 'all') {
          activeCount++;
          tags.push({ key: 'cat', label: 'Categoria: ' + activeCategory });
        }
        if (minPriceFilter !== null || maxPriceFilter !== null) {
          activeCount++;
          const minTxt = minPriceFilter !== null ? 'R$ ' + minPriceFilter : 'R$ 0';
          const maxTxt = maxPriceFilter !== null ? 'R$ ' + maxPriceFilter : '∞';
          tags.push({ key: 'price', label: minTxt + ' – ' + maxTxt });
        }
        if (promoOnlyFilter) {
          activeCount++;
          tags.push({ key: 'promo', label: 'Em promoção' });
        }
        if (badge) {
          badge.textContent = String(activeCount);
          badge.style.display = activeCount > 0 ? 'inline-block' : 'none';
        }
        if (!wrap) return;
        wrap.innerHTML = '';
        tags.forEach((tag) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'irb-active-filter-tag';
          btn.textContent = tag.label + ' ×';
          btn.addEventListener('click', () => {
            if (tag.key === 'cat') activeCategory = 'all';
            if (tag.key === 'price') {
              minPriceFilter = null;
              maxPriceFilter = null;
              const minIn = document.getElementById('min-price-input');
              const maxIn = document.getElementById('max-price-input');
              if (minIn) minIn.value = '';
              if (maxIn) maxIn.value = '';
            }
            if (tag.key === 'promo') {
              promoOnlyFilter = false;
              const promoCb = document.getElementById('irb-filter-promo-only');
              if (promoCb) promoCb.checked = false;
            }
            openCategoryPage(activeCategory, rawSearchQuery, { keepFilters: true });
          });
          wrap.appendChild(btn);
        });
      }

      function openCategoryPage(catLabel, query, options) {
        const keepFilters = Boolean(options && options.keepFilters);
        activeCategory = catLabel || 'all';
        rawSearchQuery = (query || '').trim();
        searchQuery = rawSearchQuery.toLowerCase();

        if (!keepFilters) {
          minPriceFilter = null;
          maxPriceFilter = null;
          promoOnlyFilter = false;
          const minIn = document.getElementById('min-price-input');
          const maxIn = document.getElementById('max-price-input');
          const promoCb = document.getElementById('irb-filter-promo-only');
          if (minIn) minIn.value = '';
          if (maxIn) maxIn.value = '';
          if (promoCb) promoCb.checked = false;
        }

        document.querySelectorAll('.categoryLink').forEach((c) => {
          const attr = (c.getAttribute('data-filter-cat') || '').toLowerCase();
          c.classList.toggle('active', attr === activeCategory.toLowerCase());
        });
        document.querySelectorAll('.catFilterChip').forEach((chip) => {
          const attr = (chip.getAttribute('data-filter-cat') || '').toLowerCase();
          chip.classList.toggle('active', attr === activeCategory.toLowerCase());
        });
        document.querySelectorAll('[data-sidebar-cat]').forEach((btn) => {
          const attr = (btn.getAttribute('data-sidebar-cat') || '').toLowerCase();
          btn.classList.toggle('active', attr === activeCategory.toLowerCase());
        });
        syncPricePresetButtons();
        renderActiveFilterTags();

        const hasExtraFilters =
          minPriceFilter !== null || maxPriceFilter !== null || promoOnlyFilter;

        let baseList = PRODUCTS.filter((p) => {
          const okCat = matchesCategory(p, activeCategory);
          const okSearch =
            !searchQuery ||
            (p.title || '').toLowerCase().includes(searchQuery) ||
            (p.category || '').toLowerCase().includes(searchQuery);
          return okCat && okSearch;
        });

        let titleText = activeCategory === 'all' ? 'Todos os Produtos' : activeCategory;
        if (rawSearchQuery) {
          titleText = 'Resultados para "' + rawSearchQuery + '"';
        } else if (baseList.length === 0 && activeCategory !== 'all' && !hasExtraFilters) {
          baseList = PRODUCTS.slice(0, 12);
        }

        const filtered = baseList.filter((p) => {
          if (minPriceFilter !== null && p.price < minPriceFilter) return false;
          if (maxPriceFilter !== null && p.price > maxPriceFilter) return false;
          if (promoOnlyFilter && !(p.compareAtPrice && p.compareAtPrice > p.price)) return false;
          return true;
        });

        const sortEl = document.getElementById('irb-cat-sort');
        const sortVal = sortEl ? sortEl.value : 'relevance';
        if (sortVal === 'price-asc') filtered.sort((a, b) => a.price - b.price);
        else if (sortVal === 'price-desc') filtered.sort((a, b) => b.price - a.price);
        else if (sortVal === 'name-asc') filtered.sort((a, b) => a.title.localeCompare(b.title));
        else if (sortVal === 'name-desc') filtered.sort((a, b) => b.title.localeCompare(a.title));
        else if (sortVal === 'discount-desc') {
          const pctOf = (item) =>
            item.compareAtPrice && item.compareAtPrice > item.price
              ? (item.compareAtPrice - item.price) / item.compareAtPrice
              : 0;
          filtered.sort((a, b) => pctOf(b) - pctOf(a));
        }

        document.getElementById('irb-cat-breadcrumb').textContent = titleText;
        document.getElementById('irb-cat-title').textContent = titleText;
        document.getElementById('irb-cat-count').textContent = filtered.length + ' produto(s) disponível(is)';

        const grid = document.getElementById('irb-cat-grid');
        grid.classList.toggle('grid-cols-4', catGridCols === 4);
        grid.innerHTML = '';
        if (filtered.length === 0) {
          grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;padding:40px 0;color:#6b7280;">Nenhum produto encontrado com os filtros aplicados. Tente limpar ou ajustar os filtros ao lado.</p>';
        } else {
          filtered.forEach((p) => grid.appendChild(createProductCardNode(p)));
        }

        document.getElementById('irb-mobile-drawer').classList.remove('open');
        setCatDrawerOpen(false);
        switchView('category');
      }

      function openProductPage(productId) {
        const product = PRODUCTS.find((p) => p.id === productId);
        if (!product) return;
        activePdpProduct = product;
        pdpQty = 1;
        document.getElementById('irb-pdp-qty').textContent = '1';
        const sizeBtns = Array.from(document.querySelectorAll('.pdpSizeBtn'));
        sizeBtns.forEach((b, idx) => b.classList.toggle('active', idx === 0));
        activeSize = sizeBtns[0] ? (sizeBtns[0].getAttribute('data-size-opt') || 'Padrão') : 'Padrão';

        const images = (product.images && product.images.length > 0 ? product.images : [product.imageUrl]).filter(Boolean);
        const mainImg = document.getElementById('irb-pdp-img');
        mainImg.src = images[0] || product.imageUrl;

        const thumbsEl = document.getElementById('irb-pdp-thumbs');
        thumbsEl.innerHTML = '';
        images.forEach((imgUrl, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'pdpThumb' + (idx === 0 ? ' active' : '');
          const tImg = document.createElement('img');
          tImg.src = imgUrl;
          tImg.alt = product.title;
          btn.appendChild(tImg);
          btn.addEventListener('click', () => {
            mainImg.src = imgUrl;
            thumbsEl.querySelectorAll('.pdpThumb').forEach((t) => t.classList.remove('active'));
            btn.classList.add('active');
          });
          thumbsEl.appendChild(btn);
        });

        const catLabel = product.category || 'Destaques';
        document.getElementById('irb-pdp-cat-link').textContent = catLabel;
        document.getElementById('irb-pdp-cat-link').onclick = () => openCategoryPage(catLabel, '');
        document.getElementById('irb-pdp-breadcrumb-title').textContent = product.title;
        document.getElementById('irb-pdp-cat').textContent = catLabel;
        document.getElementById('irb-pdp-title').textContent = product.title;
        document.getElementById('irb-pdp-price').textContent = formatCurrency(product.price);
        document.getElementById('irb-pdp-pix-badge').textContent = formatCurrency(product.price * 0.95) + ' no PIX (-5%)';
        document.getElementById('irb-pdp-old').textContent =
          product.compareAtPrice && product.compareAtPrice > product.price
            ? formatCurrency(product.compareAtPrice)
            : '';
        document.getElementById('irb-pdp-installments').textContent = product.installmentsText || '';
        document.getElementById('irb-pdp-desc').textContent = product.description || '';
        const cepInput = document.getElementById('irb-cep-input');
        if (cepInput) cepInput.value = '';
        document.getElementById('irb-cep-result').style.display = 'none';

        const relatedGrid = document.getElementById('irb-pdp-related');
        relatedGrid.innerHTML = '';
        PRODUCTS.filter((p) => p.id !== product.id)
          .slice(0, 4)
          .forEach((rel) => relatedGrid.appendChild(createProductCardNode(rel)));

        switchView('product');
      }

      // Navigation bindings
      function goHome() {
        activeCategory = 'all';
        searchQuery = '';
        rawSearchQuery = '';
        minPriceFilter = null;
        maxPriceFilter = null;
        promoOnlyFilter = false;
        const sInput = document.getElementById('irb-search-input');
        if (sInput) sInput.value = '';
        document.querySelectorAll('.categoryLink').forEach((c) => c.classList.remove('active'));
        const mobileDrawer = document.getElementById('irb-mobile-drawer');
        if (mobileDrawer) mobileDrawer.classList.remove('open');
        setCatDrawerOpen(false);
        switchView('home');
      }

      document.querySelectorAll('[data-go-home]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          goHome();
        });
      });

      document.getElementById('irb-go-home-logo').addEventListener('click', (e) => {
        e.preventDefault();
        goHome();
      });

      document.querySelectorAll('[data-filter-cat], [data-irb-cat]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          const cat = el.getAttribute('data-filter-cat') || el.getAttribute('data-irb-cat') || 'all';
          openCategoryPage(cat, '', { keepFilters: false });
        });
      });

      document.querySelectorAll('[data-sidebar-cat]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-sidebar-cat') || 'all';
          openCategoryPage(cat, rawSearchQuery, { keepFilters: true });
        });
      });

      document.querySelectorAll('#irb-price-presets .filterPresetBtn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const minRaw = btn.getAttribute('data-price-min') || '';
          const maxRaw = btn.getAttribute('data-price-max') || '';
          const nextMin = minRaw ? Number(minRaw) : null;
          const nextMax = maxRaw ? Number(maxRaw) : null;
          if (minPriceFilter === nextMin && maxPriceFilter === nextMax) {
            minPriceFilter = null;
            maxPriceFilter = null;
          } else {
            minPriceFilter = nextMin;
            maxPriceFilter = nextMax;
          }
          const minIn = document.getElementById('min-price-input');
          const maxIn = document.getElementById('max-price-input');
          if (minIn) minIn.value = minPriceFilter !== null ? String(minPriceFilter) : '';
          if (maxIn) maxIn.value = maxPriceFilter !== null ? String(maxPriceFilter) : '';
          openCategoryPage(activeCategory, rawSearchQuery, { keepFilters: true });
        });
      });

      const applyFiltersBtn = document.getElementById('irb-apply-filters-btn');
      if (applyFiltersBtn) {
        applyFiltersBtn.addEventListener('click', () => {
          const minIn = document.getElementById('min-price-input');
          const maxIn = document.getElementById('max-price-input');
          const promoCb = document.getElementById('irb-filter-promo-only');
          const minVal = minIn && minIn.value.trim() !== '' ? Number(minIn.value) : null;
          const maxVal = maxIn && maxIn.value.trim() !== '' ? Number(maxIn.value) : null;
          minPriceFilter = minVal !== null && Number.isFinite(minVal) && minVal >= 0 ? minVal : null;
          maxPriceFilter = maxVal !== null && Number.isFinite(maxVal) && maxVal >= 0 ? maxVal : null;
          promoOnlyFilter = Boolean(promoCb && promoCb.checked);
          openCategoryPage(activeCategory, rawSearchQuery, { keepFilters: true });
        });
      }

      const promoCheckbox = document.getElementById('irb-filter-promo-only');
      if (promoCheckbox) {
        promoCheckbox.addEventListener('change', () => {
          promoOnlyFilter = Boolean(promoCheckbox.checked);
          openCategoryPage(activeCategory, rawSearchQuery, { keepFilters: true });
        });
      }

      const clearFiltersBtn = document.getElementById('irb-clear-filters-btn');
      if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', () => {
          openCategoryPage('all', '', { keepFilters: false });
        });
      }

      document.querySelectorAll('.js-changeGrid').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cols = Number(btn.getAttribute('data-grid-cols') || 3);
          catGridCols = cols === 4 ? 4 : 3;
          document.querySelectorAll('.js-changeGrid').forEach((b) => {
            b.classList.toggle('active', Number(b.getAttribute('data-grid-cols')) === catGridCols);
          });
          const grid = document.getElementById('irb-cat-grid');
          if (grid) grid.classList.toggle('grid-cols-4', catGridCols === 4);
        });
      });

      const openCatFiltersBtn = document.getElementById('irb-open-cat-filters');
      const closeCatFiltersBtn = document.getElementById('irb-cat-filter-close');
      const catFilterBackdrop = document.getElementById('irb-cat-filter-backdrop');
      if (openCatFiltersBtn) openCatFiltersBtn.addEventListener('click', () => setCatDrawerOpen(true));
      if (closeCatFiltersBtn) closeCatFiltersBtn.addEventListener('click', () => setCatDrawerOpen(false));
      if (catFilterBackdrop) catFilterBackdrop.addEventListener('click', () => setCatDrawerOpen(false));

      document.getElementById('irb-cat-sort').addEventListener('change', () => {
        openCategoryPage(activeCategory, rawSearchQuery, { keepFilters: true });
      });

      const searchModal = document.getElementById('irb-search-modal');
      const searchToggleBtn = document.getElementById('irb-toggle-search');
      const searchCloseBtn = document.getElementById('irb-close-search');
      const searchInput = document.getElementById('irb-search-input');
      const searchLiveTitle = document.getElementById('irb-search-live-title');
      const searchLiveResults = document.getElementById('irb-search-live-results');

      function renderLiveSearchSuggestions(rawTerm) {
        if (!searchLiveResults) return;
        const term = (rawTerm || '').trim().toLowerCase();
        const matches = term
          ? PRODUCTS.filter(
              (p) =>
                (p.title || '').toLowerCase().includes(term) ||
                (p.category || '').toLowerCase().includes(term)
            )
          : PRODUCTS;

        if (searchLiveTitle) {
          searchLiveTitle.textContent = term
            ? matches.length + ' resultado(s) para "' + rawTerm.trim() + '"'
            : 'Sugestões em destaque';
        }

        searchLiveResults.innerHTML = '';
        if (matches.length === 0) {
          const empty = document.createElement('div');
          empty.style.cssText = 'font-size:13px;color:#6b7280;padding:12px 4px;';
          empty.textContent = 'Nenhum produto encontrado. Tente outro termo.';
          searchLiveResults.appendChild(empty);
          return;
        }

        matches.slice(0, 5).forEach((p) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'irb-search-item';

          const img = document.createElement('img');
          img.src = p.imageUrl || '';
          img.alt = p.title || '';

          const meta = document.createElement('div');
          meta.style.cssText = 'flex:1;min-width:0;';

          const t = document.createElement('div');
          t.style.cssText = 'font-size:13px;font-weight:600;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';
          t.textContent = p.title;

          const sub = document.createElement('div');
          sub.style.cssText = 'font-size:12px;color:#4b5563;';
          sub.textContent = (p.category || '') + ' · ' + formatCurrency(p.price);

          meta.appendChild(t);
          meta.appendChild(sub);
          btn.appendChild(img);
          btn.appendChild(meta);
          btn.addEventListener('click', () => {
            setSearchOpen(false);
            openProductPage(p.id);
          });
          searchLiveResults.appendChild(btn);
        });
      }

      function setSearchOpen(open) {
        if (!searchModal) return;
        searchModal.classList.toggle('open', open);
        searchModal.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (searchToggleBtn) searchToggleBtn.classList.toggle('is-active', open);
        if (open) {
          renderLiveSearchSuggestions(searchInput ? searchInput.value : '');
          if (searchInput) setTimeout(() => searchInput.focus(), 40);
        }
      }

      if (searchToggleBtn) {
        searchToggleBtn.addEventListener('click', () => {
          const isOpen = searchModal && searchModal.classList.contains('open');
          setSearchOpen(!isOpen);
        });
      }
      if (searchCloseBtn) {
        searchCloseBtn.addEventListener('click', () => setSearchOpen(false));
      }
      if (searchModal) {
        searchModal.addEventListener('click', (e) => {
          if (e.target === searchModal) setSearchOpen(false);
        });
        searchModal.querySelectorAll('[data-filter-cat]').forEach((chip) => {
          chip.addEventListener('click', () => setSearchOpen(false));
        });
      }
      if (searchInput) {
        searchInput.addEventListener('input', () => renderLiveSearchSuggestions(searchInput.value));
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setSearchOpen(false);
          setAccountDropdownOpen(false);
          const accountModal = document.getElementById('irb-account-modal');
          const cartDrawer = document.getElementById('irb-cart-drawer');
          const mobileDrawer = document.getElementById('irb-mobile-drawer');
          if (accountModal) accountModal.classList.remove('open');
          if (cartDrawer) cartDrawer.classList.remove('open');
          if (mobileDrawer) mobileDrawer.classList.remove('open');
          setCatDrawerOpen(false);
        }
      });

      document.getElementById('irb-search-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const q = (searchInput && searchInput.value) || '';
        setSearchOpen(false);
        openCategoryPage('all', q);
      });

      // Home product card click bindings
      document.querySelectorAll('[data-open-pdp]').forEach((el) => {
        el.addEventListener('click', () => openProductPage(el.getAttribute('data-open-pdp')));
      });

      document.querySelectorAll('[data-add-cart]').forEach((btn) => {
        btn.addEventListener('click', () => addToCart(btn.getAttribute('data-add-cart'), 1));
      });

      // PDP controls
      document.querySelectorAll('[data-size-opt]').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeSize = btn.getAttribute('data-size-opt') || 'Padrão';
          document.querySelectorAll('[data-size-opt]').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
      document.getElementById('irb-pdp-qty-dec').addEventListener('click', () => {
        pdpQty = Math.max(1, pdpQty - 1);
        document.getElementById('irb-pdp-qty').textContent = String(pdpQty);
      });
      document.getElementById('irb-pdp-qty-inc').addEventListener('click', () => {
        pdpQty = Math.min(20, pdpQty + 1);
        document.getElementById('irb-pdp-qty').textContent = String(pdpQty);
      });
      document.getElementById('irb-pdp-add').addEventListener('click', () => {
        if (activePdpProduct) addToCart(activePdpProduct.id, pdpQty, activeSize);
      });
      document.getElementById('irb-cep-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const cep = (document.getElementById('irb-cep-input').value || '').trim();
        const out = document.getElementById('irb-cep-result');
        out.style.display = 'block';
        out.textContent =
          'Frete para CEP ' +
          (cep || 'informado') +
          ': Econômico R$ 19,90 (4 a 6 dias úteis) • Expresso R$ 32,90 (1 a 2 dias úteis)';
      });

      // Cart logic
      function renderCart() {
        const countEl = document.getElementById('irb-cart-count');
        const itemsEl = document.getElementById('irb-cart-items');
        const totalEl = document.getElementById('irb-cart-total');

        const totalQty = cart.reduce((acc, item) => acc + item.qty, 0);
        const totalAmt = cart.reduce((acc, item) => acc + item.product.price * item.qty, 0);
        countEl.textContent = String(totalQty);
        totalEl.textContent = formatCurrency(totalAmt);

        if (cart.length === 0) {
          itemsEl.innerHTML = '<p style="color:#6b7280;font-size:14px;text-align:center;margin-top:40px;">Sua sacola está vazia. Clique em comprar em qualquer produto para testar!</p>';
          return;
        }

        itemsEl.innerHTML = '';
        cart.forEach((item, idx) => {
          const row = document.createElement('div');
          row.style.cssText = 'display:flex;gap:12px;align-items:center;border-bottom:1px solid #f3f4f6;padding-bottom:10px;';

          const img = document.createElement('img');
          img.src = item.product.imageUrl || '';
          img.alt = item.product.title || '';
          img.style.cssText = 'width:56px;height:56px;object-fit:cover;border-radius:6px;';

          const info = document.createElement('div');
          info.style.cssText = 'flex:1;min-width:0;';

          const titleEl = document.createElement('div');
          titleEl.style.cssText = 'font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';
          titleEl.textContent = item.product.title + (item.size ? ' (' + item.size + ')' : '');

          const priceEl = document.createElement('div');
          priceEl.style.cssText = 'font-size:13px;color:#4b5563;';
          priceEl.textContent = item.qty + 'x ' + formatCurrency(item.product.price);

          info.appendChild(titleEl);
          info.appendChild(priceEl);

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.style.cssText = 'border:none;background:none;color:#ef4444;cursor:pointer;font-size:12px;font-weight:700;';
          removeBtn.textContent = 'Remover';
          removeBtn.addEventListener('click', () => {
            cart.splice(idx, 1);
            renderCart();
          });

          row.appendChild(img);
          row.appendChild(info);
          row.appendChild(removeBtn);
          itemsEl.appendChild(row);
        });
      }

      function addToCart(productId, qty, size) {
        const product = PRODUCTS.find((p) => p.id === productId);
        if (!product) return;
        const chosenSize = size || '';
        const existing = cart.find((c) => c.product.id === productId && c.size === chosenSize);
        if (existing) existing.qty += qty || 1;
        else cart.push({ product, qty: qty || 1, size: chosenSize });
        renderCart();
        document.getElementById('irb-cart-drawer').classList.add('open');
      }

      // Modals & Drawers
      document.getElementById('irb-open-cart').addEventListener('click', () => {
        renderCart();
        document.getElementById('irb-cart-drawer').classList.add('open');
      });
      document.getElementById('irb-cart-close').addEventListener('click', () => {
        document.getElementById('irb-cart-drawer').classList.remove('open');
      });
      document.getElementById('irb-open-mobile-menu').addEventListener('click', () => {
        document.getElementById('irb-mobile-drawer').classList.add('open');
      });
      document.getElementById('irb-mobile-close').addEventListener('click', () => {
        document.getElementById('irb-mobile-drawer').classList.remove('open');
      });
      const accountModalEl = document.getElementById('irb-account-modal');
      const accountDropdownEl = document.getElementById('irb-account-dropdown');
      const accountBackdropEl = document.getElementById('irb-account-backdrop');
      const accountToggleBtn = document.getElementById('irb-open-account');
      const accountWrapEl = document.getElementById('irb-account-wrap');

      function setAccountDropdownOpen(open) {
        if (accountDropdownEl) accountDropdownEl.classList.toggle('open', open);
        if (accountBackdropEl) {
          accountBackdropEl.classList.toggle('open', open);
          accountBackdropEl.setAttribute('aria-hidden', open ? 'false' : 'true');
        }
        if (accountToggleBtn) {
          accountToggleBtn.classList.toggle('is-active', open);
          accountToggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
      }

      function openAccountModalInMode(mode) {
        setAccountDropdownOpen(false);
        if (!accountModalEl) return;
        const titleEl = document.getElementById('irb-account-modal-title');
        const descEl = document.getElementById('irb-account-modal-desc');
        const nameField = document.getElementById('irb-account-name-field');
        const submitBtn = document.getElementById('irb-account-submit-btn');
        const msgEl = document.getElementById('irb-account-msg');
        if (msgEl) msgEl.style.display = 'none';
        if (mode === 'register') {
          if (titleEl) titleEl.textContent = 'Criar conta';
          if (descEl) descEl.textContent = 'Cadastre-se rapidamente para acompanhar pedidos e aproveitar ofertas exclusivas.';
          if (nameField) {
            nameField.style.display = 'block';
            nameField.required = true;
          }
          if (submitBtn) submitBtn.textContent = 'Criar Minha Conta (Demo)';
        } else {
          if (titleEl) titleEl.textContent = 'Entrar na sua conta';
          if (descEl) descEl.textContent = 'Acesse seus pedidos, favoritos e dados cadastrais no ambiente seguro da Irroba.';
          if (nameField) {
            nameField.style.display = 'none';
            nameField.required = false;
          }
          if (submitBtn) submitBtn.textContent = 'Entrar na Conta (Demo)';
        }
        accountModalEl.classList.add('open');
      }

      if (accountToggleBtn) {
        accountToggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = accountDropdownEl && accountDropdownEl.classList.contains('open');
          setAccountDropdownOpen(!isOpen);
        });
      }
      if (accountBackdropEl) {
        accountBackdropEl.addEventListener('click', () => setAccountDropdownOpen(false));
      }
      document.addEventListener('click', (e) => {
        if (
          accountDropdownEl &&
          accountDropdownEl.classList.contains('open') &&
          accountWrapEl &&
          !accountWrapEl.contains(e.target)
        ) {
          setAccountDropdownOpen(false);
        }
      });
      document.querySelectorAll('[data-account-action]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openAccountModalInMode(btn.getAttribute('data-account-action') || 'login');
        });
      });
      document.getElementById('irb-account-close').addEventListener('click', () => {
        if (accountModalEl) accountModalEl.classList.remove('open');
      });
      if (accountModalEl) {
        accountModalEl.addEventListener('click', (e) => {
          if (e.target === accountModalEl) accountModalEl.classList.remove('open');
        });
      }
    })();
  </script>
</body>
</html>"
`;

