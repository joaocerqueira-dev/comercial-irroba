    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0.52) 0%,rgba(0,0,0,0.16) 24%,rgba(0,0,0,0.03) 48%,rgba(0,0,0,0.82) 100%);"></div>
