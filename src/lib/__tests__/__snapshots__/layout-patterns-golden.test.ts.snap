              <button type="button" class="categorySidebar__close" id="irb-cat-filter-close" aria-label="Fechar filtros"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
            </div>

            <div class="irb-active-filters" id="irb-active-filters"></div>

            <details open class="filters filter-category-container">
              <summary>
                <span class="filter-title">Categorias</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <ul class="filterSidebarList" id="irb-sidebar-cats">
                <li>
                  <button type="button" class="filterSidebarBtn active" data-sidebar-cat="all">
                    <span>Todos os produtos</span>
                    <span class="filterSidebarCount" data-cat-count="all">10</span>
                  </button>
                </li>
                <li>
                  <button type="button" class="filterSidebarBtn" data-sidebar-cat="Categoria A">
                    <span>Categoria A</span>
                    <span class="filterSidebarCount" data-cat-count="categoria a">0</span>
                  </button>
                </li><li>
                  <button type="button" class="filterSidebarBtn" data-sidebar-cat="Categoria B">
                    <span>Categoria B</span>
                    <span class="filterSidebarCount" data-cat-count="categoria b">0</span>
                  </button>
                </li>
              </ul>
            </details>

            <details open class="filters filter-price-container" data-price-name="Faixa de Preço">
              <summary>
                <span class="filter-title">Faixa de Preço</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="filterPricePresets" id="irb-price-presets">
                <button type="button" class="filterPresetBtn" data-price-min="" data-price-max="150">Até R$ 150</button>
                <button type="button" class="filterPresetBtn" data-price-min="150" data-price-max="350">R$ 150 – R$ 350</button>
                <button type="button" class="filterPresetBtn" data-price-min="350" data-price-max="">Acima de R$ 350</button>
              </div>
              <div class="range_inputs">
                <div>
                  <label for="min-price-input">Mínimo (R$)</label>
                  <input type="number" min="0" step="1" id="min-price-input" class="price-input" placeholder="0" />
                </div>
                <div>
                  <label for="max-price-input">Máximo (R$)</label>
                  <input type="number" min="0" step="1" id="max-price-input" class="price-input" placeholder="9999" />
                </div>
              </div>
            </details>

            <details open class="filters filter-promo-container">
              <summary>
                <span class="filter-title">Ofertas</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <label class="filterCheckboxLabel">
                <input type="checkbox" id="irb-filter-promo-only" />
                <span>Apenas em promoção</span>
              </label>
            </details>

            <div class="filterActionContainer">
              <button type="button" id="irb-apply-filters-btn" class="filter-button">Aplicar</button>
              <button type="button" id="irb-clear-filters-btn" class="clear-filters">Limpar</button>
            </div>
          </aside>

          <div id="mainContent" class="pageContent__main">
            <div class="pageControls pageControls--category">
              <div class="toolbar-shop">
                <div class="toolbar-shop-left">
                  <button type="button" class="customFilterV2-toggle" id="irb-open-cat-filters" aria-label="Abrir filtros">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg>
                    <span>Filtrar</span>
                    <span id="irb-cat-filter-badge" style="display:none;padding:1px 6px;border-radius:999px;background:rgba(255,255,255,0.25);font-size:11px;">0</span>
                  </button>
                  <div class="toolbar-shop-sorter">
                    <span>Visualização:</span>
                    <button type="button" class="js-changeGrid active" data-grid-cols="3" title="3 colunas" aria-label="Exibir 3 produtos por linha"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="4.5" height="7" rx="1"/><rect x="9.75" y="4" width="4.5" height="7" rx="1"/><rect x="16.5" y="4" width="4.5" height="7" rx="1"/><rect x="3" y="13" width="4.5" height="7" rx="1"/><rect x="9.75" y="13" width="4.5" height="7" rx="1"/><rect x="16.5" y="13" width="4.5" height="7" rx="1"/></svg></button>
                    <button type="button" class="js-changeGrid" data-grid-cols="4" title="4 colunas" aria-label="Exibir 4 produtos por linha"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="7.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="12.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="17.5" y="4" width="3.5" height="7" rx="0.8"/><rect x="2.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="7.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="12.5" y="13" width="3.5" height="7" rx="0.8"/><rect x="17.5" y="13" width="3.5" height="7" rx="0.8"/></svg></button>
                  </div>
                </div>
                <select id="irb-cat-sort" class="categorySortSelect" aria-label="Ordenar produtos">
                  <option value="relevance">Ordenar: Padrão</option>
                  <option value="name-asc">Nome (A - Z)</option>
                  <option value="name-desc">Nome (Z - A)</option>
                  <option value="price-asc">Menor Preço</option>
                  <option value="price-desc">Maior Preço</option>
                  <option value="discount-desc">Maiores Descontos</option>
                </select>
