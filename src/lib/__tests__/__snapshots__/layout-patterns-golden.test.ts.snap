    <!-- 3. VIEW: PÁGINA COMPLETA DE PRODUTO (PDP .product-content) -->
    <div id="irb-view-product" class="storeView">
      <div class="container">
        <nav class="irb-breadcrumb" aria-label="Breadcrumb">
          <button type="button" data-go-home="1">Início</button>
