# SQLite. O caminho é relativo a prisma/ (gera prisma/dev.db).
# No Docker o compose fixa file:/app/data/prod.db e ignora este valor.
DATABASE_URL="file:./dev.db"
# Opcional: obtenha gratuitamente em https://aistudio.google.com para análise multimodal com Gemini.
# Sem chave, o blueprint é heurístico e as imagens de IA caem no fallback local (arte renderizada pelo Chromium).
GEMINI_API_KEY=""
# Modelo padrão para análise multimodal da identidade visual
GEMINI_MODEL="gemini-3.5-flash"
# Opcional: modelo de imagem preferido (arte de banner, edição de imagem). Vazio = lista padrão
# (gemini-3.1-flash-image, gemini-3.1-flash-lite-image, gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=""
# Primeiro admin, criado no seed quando não há usuários. Depois, a senha é trocada em /conta/senha.
ADMIN_EMAIL=""
ADMIN_PASS=""
# Segredo que assina o cookie de acesso ao link do cliente. Obrigatório em produção (mín. 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=""
# Base pública (CDN/domínio) onde /api/captures/* fica acessível; usada no HTML exportado para a Irroba
PUBLIC_ASSET_BASE_URL=""

# --- Segurança / limites (opcionais) ---
# Leia o IP do cliente de X-Forwarded-For (hop mais à direita). Use 1 SÓ atrás de um reverse proxy confiável
# que sobrescreva esse header; sem isso o header é forjável e o rate limit usa a chave "unknown".
# TRUST_PROXY=1
# Requisições por minuto por usuário+IP nas rotas caras (generate, reanalyze, ai-image, mobile-capture). Padrão 30.
# Os limites ficam em memória: válido para um container com uma réplica.
# RATE_LIMIT_PER_MIN=30
# Jobs simultâneos do Chromium (geração, arte IA, recaptura mobile). Padrão 2.
# MAX_BROWSER_JOBS=2
# Desliga o sandbox do Chromium. Só como escape para dev em WSL/CI ou container sem perfil seccomp;
# o navegador abre sites de terceiros, então evite em produção.
# PLAYWRIGHT_NO_SANDBOX=1
